{{!--
Contact form (Formspree) — reusable across home + service pages.

Parameters (Handlebars hash args):

    show_selector       Boolean. If true, renders the "¿Sobre qué querés hablar?"
                        radio group. If false/omitted, no selector is shown.
                        The home uses show_selector=true; service pages don't.

    tipo_predefinido    String. When show_selector is false, this value is
                        emitted as a hidden input `tipo_consulta`. Formspree
                        receives it under the same field name as the radio,
                        so from the backend it's indistinguishable which
                        page sent it. Accepted values:
                          "equipo" → "El Viaje"
                          "lider"  → "Acompañamiento"
                          "charla" → "Una charla para mi equipo"
                          "sesion" → "Sesión para masticar"

    origen              String. Value for the hidden `origen` field. Defaults
                        to "home". Pass "viaje", "lideres", etc. so leads
                        can be attributed by source.

    subject             String. Value for `_subject`. Defaults to
                        "Contacto — desde la home". Override per page for
                        clarity in the inbox.

    message_label       String. Label for the message textarea. Defaults to
                        "Contame un poco más".

    message_placeholder String. Placeholder for the message textarea. Defaults
                        to "¿Qué estás viviendo o qué te gustaría trabajar?".

Constraint: only one instance of this partial per page. IDs are DOM-global
(mm-home-* prefix retained for backward compat with existing CSS and JS
selectors). Two instances on the same page would collide.
--}}

<form
    id="mm-home-formspree"
    class="mm-home-contact__form"
    action="https://formspree.io/f/maqpeljq"
    method="POST"
>
    <input type="hidden" name="_subject" value="{{#if subject}}{{subject}}{{else}}Contacto — desde la home{{/if}}">
    <input type="hidden" name="origen" value="{{#if origen}}{{origen}}{{else}}home{{/if}}">

    {{#unless show_selector}}
        {{!-- Hidden tipo_consulta for pages without selector.
             Same field name as the radio group, so Formspree sees a single
             consistent `tipo_consulta` regardless of which form submitted. --}}
        {{#match tipo_predefinido "equipo"}}
            <input type="hidden" name="tipo_consulta" value="El Viaje">
        {{else match tipo_predefinido "lider"}}
            <input type="hidden" name="tipo_consulta" value="Acompañamiento">
        {{else match tipo_predefinido "charla"}}
            <input type="hidden" name="tipo_consulta" value="Una charla para mi equipo">
        {{else match tipo_predefinido "sesion"}}
            <input type="hidden" name="tipo_consulta" value="Sesión para masticar">
        {{/match}}
    {{/unless}}

    {{!-- Field order is intentionally lead-first: name + email, then what the
         person is bringing, and only then (optionally) what they want to
         explore. The service selector comes last and is not required. --}}
    <div class="mm-home-contact__row mm-home-contact__row--two">
        <div class="mm-home-contact__field">
            <label class="mm-home-contact__label" for="mm-home-name">Nombre</label>
            <input
                id="mm-home-name"
                name="nombre"
                type="text"
                autocomplete="name"
                required
                class="mm-home-contact__input"
            >
        </div>

        <div class="mm-home-contact__field">
            <label class="mm-home-contact__label" for="mm-home-email">Email</label>
            <input
                id="mm-home-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="mm-home-contact__input"
            >
        </div>
    </div>

    <div class="mm-home-contact__row">
        <div class="mm-home-contact__field">
            <label class="mm-home-contact__label" for="mm-home-message">{{#if message_label}}{{message_label}}{{else}}Contame un poco más{{/if}}</label>
            <textarea
                id="mm-home-message"
                name="mensaje"
                rows="6"
                required
                placeholder="{{#if message_placeholder}}{{message_placeholder}}{{else}}¿Qué estás viviendo o qué te gustaría trabajar?{{/if}}"
                class="mm-home-contact__textarea"
            ></textarea>
        </div>
    </div>

    {{#if show_selector}}
        <fieldset class="mm-home-contact__choice">
            <legend class="mm-home-contact__choice-legend">¿Qué te interesa explorar?</legend>
            <div class="mm-home-contact__choice-options">
                <label class="mm-home-contact__choice-option">
                    <input type="radio" name="tipo_consulta" value="Una charla para mi equipo">
                    <span>Una charla para mi equipo</span>
                </label>
                <label class="mm-home-contact__choice-option">
                    <input type="radio" name="tipo_consulta" value="Acompañamiento">
                    <span>Acompañamiento</span>
                </label>
                <label class="mm-home-contact__choice-option">
                    <input type="radio" name="tipo_consulta" value="El Viaje">
                    <span>El Viaje</span>
                </label>
                <label class="mm-home-contact__choice-option">
                    <input type="radio" name="tipo_consulta" value="Todavía no sé">
                    <span>Todavía no sé</span>
                </label>
            </div>
        </fieldset>
    {{/if}}

    {{!-- Honeypot --}}
    <div class="mm-home-contact__honeypot" aria-hidden="true">
        <label for="mm-home-website">No completar este campo</label>
        <input id="mm-home-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
    </div>

    <div class="mm-actions">
        <button type="submit" class="mm-btn mm-btn--primary mm-btn--lg">
            Enviar mensaje
        </button>
    </div>

    <p id="mm-home-form-status" class="mm-home-contact__status" role="status" aria-live="polite"></p>
</form>

{{!-- AJAX submit + optional URL-driven radio preselection.
     preselectFromUrl is a no-op on pages without radios (querySelectorAll
     returns 0 items). Same JS works for home, /viaje/, /lideres/. --}}
<script>
(function () {
    var form = document.getElementById('mm-home-formspree');
    if (!form) return;
    var status = document.getElementById('mm-home-form-status');
    var submitBtn = form.querySelector('button[type="submit"]');

    function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg;
        status.dataset.state = state || '';
    }

    {{!-- Deep-link support: /?tipo=xxx#mm-home-contact preselects the radio.
         No-op if the form has no radios (service pages with hidden tipo). --}}
    function preselectFromUrl() {
        try {
            var search = window.location.search || '';
            var match = search.match(/[?&]tipo=([^&]+)/);
            if (!match) return;
            var requested = decodeURIComponent(match[1]).toLowerCase();
            var map = {
                'charla':         'Una charla para mi equipo',
                'capacitacion':   'Una charla para mi equipo',
                'capacitación':   'Una charla para mi equipo',
                'equipo':         'Una charla para mi equipo',
                'lider':          'Acompañamiento',
                'líder':          'Acompañamiento',
                'sesion':         'Acompañamiento',
                'sesión':         'Acompañamiento',
                'acompanamiento': 'Acompañamiento',
                'acompañamiento': 'Acompañamiento',
                'viaje':          'El Viaje',
                'masticada':      'El Viaje'
            };
            var target = map[requested];
            if (!target) return;
            var radios = form.querySelectorAll('input[name="tipo_consulta"]');
            for (var i = 0; i < radios.length; i++) {
                if (radios[i].value === target) {
                    radios[i].checked = true;
                    break;
                }
            }
        } catch (e) { /* noop */ }
    }
    preselectFromUrl();

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.dataset.label = submitBtn.textContent;
            submitBtn.textContent = 'Enviando…';
        }
        setStatus('', 'loading');

        var data = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (res.ok) {
                form.reset();
                setStatus('Gracias. Ya recibí tu mensaje. Te voy a leer con atención y te respondo pronto.', 'success');
            } else {
                return res.json().then(function (body) {
                    var msg = (body && body.errors && body.errors[0] && body.errors[0].message)
                        || 'Algo no funcionó. Probá de nuevo en un momento.';
                    setStatus(msg, 'error');
                }).catch(function () {
                    setStatus('Algo no funcionó. Probá de nuevo en un momento.', 'error');
                });
            }
        }).catch(function () {
            setStatus('No pudimos enviar el mensaje. Revisá tu conexión y probá de nuevo.', 'error');
        }).finally(function () {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.label || 'Enviar mensaje';
            }
        });
    });
})();
</script>
