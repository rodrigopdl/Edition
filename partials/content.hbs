<article class="single mm-v2 mm-post {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="single-header mm-post-header gh-canvas">
            {{#is "post"}}
            <div class="single-meta mm-post-meta">
                <span class="single-meta-item single-meta-date mm-post-meta__date">
                    <time datetime="{{date format="YYYY-MM-DD"}}">
                        {{date published_at format="D MMM YYYY"}}
                    </time>
                </span>
            </div>
            {{/is}}

            <h1 class="single-title mm-post-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <div class="single-excerpt mm-post-excerpt">
                    {{custom_excerpt}}
                </div>
            {{/if}}

            <div class="author-name" style="display: none;">{{authors}}</div>

            {{#if feature_image}}
            {{#unless no_image}}
                <figure class="single-media mm-post-media kg-width-{{width}}">
                    <img srcset="{{> "srcset"}}" sizes="(min-width: 1023px) 920px, calc(90vw)" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager" fetchpriority="high">
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/unless}}
            {{/if}}
        </header>
    {{/match}}

    <div class="single-content mm-post-content gh-content gh-canvas">
        {{content}}
    </div>

    {{#is "post"}}
        {{!-- Las tres formas de trabajar conmigo — continuación natural tras la
             pregunta final del Bocado. Solo en posts. Sin caja: integrado sobre
             el navy, editorial. Tres columnas en desktop, apiladas en mobile. --}}
        <aside class="mm-post-sessions gh-canvas" aria-label="Formas de trabajar con Rodri">
            <p class="mm-post-sessions__q">¿Seguimos masticando?</p>

            <ul class="mm-post-ways" role="list">
                <li class="mm-post-ways__item">
                    <h3 class="mm-post-ways__name">Sesiones 1:1</h3>
                    <p class="mm-post-ways__desc">Una cabeza más para pensar eso que tenés entre manos.</p>
                    <a href="/sesiones/" class="mm-post-sessions__link mm-post-ways__link">Conocé las sesiones <span aria-hidden="true">→</span></a>
                </li>
                <li class="mm-post-ways__item">
                    <h3 class="mm-post-ways__name">Masticadas</h3>
                    <p class="mm-post-ways__desc">Historias e ideas sobre liderazgo para abrir conversaciones que acerquen a un equipo.</p>
                    <a href="/charlas/" class="mm-post-sessions__link mm-post-ways__link">Conocé las masticadas <span aria-hidden="true">→</span></a>
                </li>
                <li class="mm-post-ways__item">
                    <h3 class="mm-post-ways__name">El Viaje</h3>
                    <p class="mm-post-ways__desc">Un mes para salir del día a día, profundizar conversaciones y conocerse mejor como grupo.</p>
                    <a href="/viaje/" class="mm-post-sessions__link mm-post-ways__link">Conocé El Viaje <span aria-hidden="true">→</span></a>
                </li>
            </ul>
        </aside>

        <div class="single-footer mm-post-footer gh-canvas">
            {{> "share"}}
        </div>
    {{/is}}
</article>
