<section class="mm-content-sections mm-related-section">
    <div class="mm-sections-wrapper">
        
        {{!-- Related Posts --}}
        {{#get "posts" limit="6" filter="tags:[{{post.tags}}]+id:-{{post.id}}" as |related|}}
        {{#if related}}
        <div class="mm-section">
            <h3 class="mm-section-title">Seguí masticando...</h3>
            <ul class="mm-items-list">
                {{#foreach related}}
                <li class="mm-item">
                    <a href="{{url}}" class="mm-item-link">{{title}}</a>
                </li>
                {{/foreach}}
            </ul>
        </div>
        {{/if}}
        {{/get}}
        
        {{!-- Featured Posts (Los Favoritos) --}}
        {{!--#get "posts" filter="featured:true+id:-{{post.id}}" limit="6" as |featured|}}
        {{#if featured}}
        <div class="mm-section">
            <h3 class="mm-section-title">Favoritos de la comunidad</h3>
            <ul class="mm-items-list">  
                {{#foreach featured}}
                <li class="mm-item">
                    <a href="{{url}}" class="mm-item-link">{{title}}</a>
                </li>
                {{/foreach}}
            </ul>
        </div>
        {{/if}}
        {{/get}}--}}
        
    </div>
</section>