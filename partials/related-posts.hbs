<section class="related-wrapper mm-post-related mm-v2">
    <div class="mm-canvas">
        {{#get "posts" limit="6" filter="tags:[{{post.tags}}]+id:-{{post.id}}" as |related|}}
        {{#if related}}
        <header class="mm-post-related__header">
            <p class="mm-eyebrow">Seguí masticando</p>
            <h2 class="mm-v2-title mm-post-related__title">
                Otros <span class="mm-accent">bocados.</span>
            </h2>
        </header>

        <ul class="related-grid mm-post-related__list" data-shuffle="true">
            {{#foreach related}}
            <li class="related-card mm-post-related__item" data-related-post>
                <a href="{{url}}" class="related-card-link mm-post-related__link">
                    <div class="mm-post-related__meta">
                        <time class="mm-post-related__date" datetime="{{date format="YYYY-MM-DD"}}">
                            {{date format="D MMM YYYY"}}
                        </time>
                    </div>
                    <h3 class="related-card-title mm-post-related__item-title">{{title}}</h3>
                    {{#if custom_excerpt}}
                        <p class="mm-post-related__excerpt">{{custom_excerpt}}</p>
                    {{else}}
                        {{#if excerpt}}
                            <p class="mm-post-related__excerpt">{{excerpt words="24"}}</p>
                        {{/if}}
                    {{/if}}
                </a>
            </li>
            {{/foreach}}
        </ul>

        <p class="mm-post-related__footer">
            <a href="/bocados" class="mm-post-related__archive">
                Ver el archivo completo
                <span aria-hidden="true">→</span>
            </a>
        </p>
        {{/if}}
        {{/get}}
    </div>
</section>
