{{!-- Orden tras el post (compartir ya quedó dentro del article, pegado al
     contenido): suscripción a Bocados → "¿Seguimos masticando?" → "Otros
     bocados" → comentarios. --}}

{{!-- Suscripción a Bocados (se omite en posts con paywall para no apilar dos
     pedidos de email). --}}
{{#post}}
    {{#if access}}
        {{> "bottom-cta"}}
    {{else}}
        {{> "bottom-cta" paywalled=true}}
    {{/if}}
{{/post}}

{{!-- One invitation to continue reflecting together, before related articles. --}}
{{#post}}
{{#is "post"}}
    <aside class="mm-post-masticadas mm-v2" aria-labelledby="post-masticadas-title">
        {{> "masticada-plate"}}
        <div class="mm-post-masticadas__copy">
            <h2 id="post-masticadas-title">¿Y si seguimos masticando en equipo?</h2>
            <a href="/masticadas/" class="mm-btn mm-btn--primary">Conocé las masticadas</a>
        </div>
    </aside>
{{/is}}
{{/post}}

{{!-- "Otros bocados" (related). Siempre renderiza: usa las tags/id del post,
     que solo resuelven fuera del bloque post. --}}
{{#if @custom.show_related_posts}}
    {{> "related-posts"}}
{{/if}}

{{#post}}
    {{> "comments"}}
{{/post}}



