{{!-- Orden tras el post (compartir ya quedó dentro del article, pegado al
     contenido): suscripción a Bocados → "¿Seguimos masticando?" → "Otros
     bocados" → comentarios. --}}

{{!-- Suscripción a Bocados (se omite en posts con paywall para no apilar dos
     pedidos de email). --}}
{{#post}}
    {{#if access}}
        {{> "bottom-cta"}}
    {{else}}
        {{> "bottom-cta" paywalled=true}}
    {{/if}}
{{/post}}

{{!-- "Otros bocados" (related). Siempre renderiza: usa las tags/id del post,
     que solo resuelven fuera del bloque post. --}}
{{#if @custom.show_related_posts}}
    {{> "related-posts"}}
{{/if}}

{{!-- "¿Seguimos masticando?" — las tres formas de trabajar conmigo. Va al final,
     tras "Otros bocados". Solo en posts; integrado sobre el navy, sin caja. --}}
{{#post}}
{{#is "post"}}
    <aside class="mm-post-sessions mm-v2 gh-canvas" aria-label="Formas de trabajar con Rodri">
        <p class="mm-post-sessions__q">¿Seguimos masticando?</p>

        <ul class="mm-post-ways" role="list">
            <li class="mm-post-ways__item">
                <h3 class="mm-post-ways__name">Masticadas para equipos</h3>
                <p class="mm-post-ways__desc">Historias e ideas para pensar juntos y abrir conversaciones que no suelen darse en el día a día.</p>
                <a href="/masticadas/" class="mm-post-sessions__link mm-post-ways__link">Conocé las masticadas</a>
            </li>

            <li class="mm-post-ways__item">
                <h3 class="mm-post-ways__name">Masticadas individuales</h3>
                <p class="mm-post-ways__desc">Un encuentro para pensar a fondo sobre algo que te importa, con historias e ideas que enriquecen la conversación.</p>
                <a href="/sesiones/" class="mm-post-sessions__link mm-post-ways__link">Conocé las masticadas individuales</a>
            </li>

            <li class="mm-post-ways__item">
                <h3 class="mm-post-ways__name">El Viaje</h3>
                <p class="mm-post-ways__desc">Un mes para salir del día a día, profundizar conversaciones y conocerse mejor como grupo.</p>
                <a href="/viaje/" class="mm-post-sessions__link mm-post-ways__link">Conocé El Viaje</a>
            </li>
        </ul>
    </aside>
{{/is}}
{{/post}}

{{#post}}
    {{> "comments"}}
{{/post}}



