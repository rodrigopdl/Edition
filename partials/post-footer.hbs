{{!--
    Related posts always render (template uses {{post.tags}} / {{post.id}}
    which only resolve outside the {{#post}} block).
--}}
{{#if @custom.show_related_posts}}
    {{> "related-posts"}}
{{/if}}

{{!-- Bottom subscribe form: skip on paywalled posts. --}}
{{#post}}
    {{#if access}}
        {{> "bottom-cta"}}
    {{else}}
        {{> "bottom-cta" paywalled=true}}
    {{/if}}

    {{> "comments"}}
{{/post}}



