{{!--
    Bottom newsletter block — editorial, consistent with /bocados.
    When invoked from a post context, the caller can pass `post_access`
    so we can skip the block on paywalled posts (content-cta is already
    visible inside the article, avoiding two stacked subscribe asks).
    Pages/other contexts that don't pass it still render the block.
--}}
{{#unless @member}}
{{#if @site.members_enabled}}
{{#unless @site.members_invite_only}}
{{#unless paywalled}}
<section class="mm-post-bottom mm-v2">
    <div class="mm-canvas">
        <div class="mm-post-bottom__panel">
            <header class="mm-post-bottom__header">
                <p class="mm-eyebrow">Suscribirse</p>
                <h2 class="mm-v2-title mm-post-bottom__title">
                    Un bocado nuevo <span class="mm-accent">cada miércoles.</span>
                </h2>
                <p class="mm-post-bottom__lede">
                    Si este te dejó pensando, puedo mandarte el próximo por mail.
                </p>
            </header>

            <form class="mm-post-bottom__form" data-members-form>
                <label for="mm-post-bottom-email" class="mm-visually-hidden">Tu email</label>
                <div class="mm-post-bottom__field">
                    <input
                        id="mm-post-bottom-email"
                        class="mm-post-bottom__input"
                        type="email"
                        name="email"
                        data-members-email
                        placeholder="tu@email.com"
                        required="true"
                    >
                    <button class="mm-post-bottom__btn" type="submit" aria-label="Suscribirme a Bocados">
                        Recibir los bocados
                    </button>
                </div>
                <p class="mm-post-bottom__note">Sin spam. Cancelás cuando quieras.</p>
                <p class="error-message"></p>
                <p class="success-message">Listo. Ya estás adentro. Te voy a mandar el próximo bocado.</p>
            </form>
        </div>
    </div>
</section>
{{/unless}}
{{/unless}}
{{/if}}
{{/unless}}
