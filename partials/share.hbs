<div class="share mm-post-share">
    <p class="mm-post-share__label">Compartir este bocado</p>
    <div class="mm-post-share__buttons">
        <a class="share-link mm-post-share__link" href="https://api.whatsapp.com/send?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp">
            {{> "icons/whatsapp"}}
            <span>WhatsApp</span>
        </a>
        <a class="share-link mm-post-share__link" href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
            {{> "icons/linkedin"}}
            <span>LinkedIn</span>
        </a>
        <a class="share-link mm-post-share__link" href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en X">
            {{> "icons/twitter"}}
            <span>X</span>
        </a>
        <a class="share-link mm-post-share__link" href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook">
            {{> "icons/facebook"}}
            <span>Facebook</span>
        </a>
        <button class="share-link share-link-copy mm-post-share__link mm-post-share__link--copy" data-url="{{url absolute="true"}}" aria-label="Copiar link">
            {{> "icons/copy"}}
            <span class="copy-text">Copiar link</span>
        </button>
    </div>
</div>
