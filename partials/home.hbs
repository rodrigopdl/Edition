{{!< default}}

<main class="homepage-main mm-v2">

    {{!-- 1. Hero ------------------------------------------------------------ --}}
    <section class="mm-v2-hero" aria-labelledby="hero-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <h1 class="mm-hero__title" id="hero-title">
                    Ayudo a líderes y equipos a <span class="mm-accent">pensar mejor.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Con historias que hacen que cada uno se encuentre con lo suyo, y un lenguaje propio que se queda: el mundo de <em>La Bestia</em>.</p>
                </div>

                <div class="mm-actions mm-actions--center">
                    <a href="/equipos/" class="mm-btn mm-btn--primary mm-btn--lg">
                        Para mi equipo
                        <span aria-hidden="true"> →</span>
                    </a>
                    <a href="/lideres/" class="mm-btn mm-btn--primary mm-btn--lg">
                        Para mí
                        <span aria-hidden="true"> →</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. Servicios (Para equipos / Para líderes) ------------------------- --}}
    <section class="mm-ways" id="mm-home-ways" aria-labelledby="ways-title">
        <div class="mm-canvas">
            <header class="mm-section-header">
                <p class="mm-eyebrow">Servicios</p>
                <h2 class="mm-v2-title" id="ways-title">
                    Dos formas de <span class="mm-accent">trabajar juntos.</span>
                </h2>
            </header>

            <div class="mm-ways__grid mm-ways__grid--two">
                <article class="mm-way">
                    <h3 class="mm-way__title">Para equipos</h3>
                    <p class="mm-way__text">
                        Desarrollo de habilidades blandas para equipos, a través de historias y un lenguaje propio que se impregna. Cada propuesta se arma a medida.
                    </p>
                    <a href="/equipos/" class="mm-way__link">
                        Conocer más
                        <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="mm-way">
                    <h3 class="mm-way__title">Para líderes</h3>
                    <p class="mm-way__text">
                        Un espacio individual para pensar decisiones, encontrar claridad y desarrollar tu forma de liderar. Desde una sesión puntual hasta un acompañamiento sostenido.
                    </p>
                    <a href="/lideres/" class="mm-way__link">
                        Conocer más
                        <span aria-hidden="true">→</span>
                    </a>
                </article>
            </div>
        </div>
    </section>

    {{!-- 3. Quién soy — Hola, soy Rodri ------------------------------------- --}}
    <section class="mm-intro" aria-labelledby="intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri"
                            class="mm-intro__img"
                            width="900"
                            height="1100"
                            loading="lazy"
                        >
                    </div>
                </figure>

                <div class="mm-intro__text">
                    <p class="mm-eyebrow">Acerca</p>
                    <h2 class="mm-v2-title" id="intro-title">
                        Hola, <span class="mm-accent">soy Rodri.</span>
                    </h2>
                    <div class="mm-prose mm-prose--intro">
                        <p>Durante más de una década trabajé en WyeWorks, una consultora de software uruguaya. Empecé como desarrollador, pero con los años mi rol fue mutando: terminé siendo acompañante estratégico del CEO.</p>
                        <p>En el camino descubrí que los problemas más difíciles casi nunca eran técnicos, sino humanos. Y que empezaban por mí. Para liderar a otros, primero tenía que aprender a liderarme a mí mismo. A reconocer esa fuerza interior que nos frena y nos hace dudar —la que llamo <em>La Bestia</em>— y a domarla.</p>
                        <p>No llego a esto desde el lugar del experto que enseña, sino desde el de alguien que comparte su propia búsqueda. <em>Para masticar</em> nació para eso, y con el tiempo me llevó a publicar un libro, dar charlas y crear formas distintas de seguir masticando, en voz alta y acompañado.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 4. La Bestia ------------------------------------------------------- --}}
    <section class="mm-bestia" aria-labelledby="bestia-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-bestia__grid">
                <div class="mm-bestia__visual">
                    <img
                        src="{{asset "images/cover-es-720.webp"}}"
                        srcset="{{asset "images/cover-es-720.webp"}} 720w, {{asset "images/cover-es-1080.webp"}} 1080w"
                        sizes="240px"
                        alt="La Bestia, libro de Rodri"
                        class="mm-bestia__book"
                        loading="lazy"
                        width="720"
                        height="1152"
                    >
                </div>
                <div class="mm-bestia__text">
                    <p class="mm-eyebrow">El libro</p>
                    <h2 class="mm-v2-title" id="bestia-title">
                        <span class="mm-accent">La Bestia.</span>
                    </h2>
                    <div class="mm-prose">
                        <p>Gran parte de mi trabajo nace de una idea: todos tenemos una Bestia. Esa fuerza interior que nos frena, nos hace dudar, y nos aleja de la persona que queremos ser.</p>
                        <p>Aprender a reconocerla y a domarla es el primer paso para liderarnos a nosotros mismos. De eso trata mi primer libro.</p>
                    </div>
                    <div class="mm-actions">
                        <a href="/bestia/" class="mm-btn mm-btn--ghost">Conocé La Bestia</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 5. Testimonio ------------------------------------------------------
         Un testimonio único, full-width, patrón .mm-testimonial existente.
         Para sumar un 2do testimonio al lado en el futuro haría falta CSS
         nuevo (grid de 2 col + ajustes tipográficos + responsive) — no está
         hecho todavía. Estructura actual: un <figure> dentro de la section. --}}
    <section class="mm-testimonial" aria-labelledby="testimonial-title">
        <div class="mm-canvas">
            <p class="mm-eyebrow mm-eyebrow--muted">Testimonio</p>
            <figure class="mm-testimonial__figure">
                <blockquote class="mm-testimonial__quote" id="testimonial-title">
                    <span class="mm-testimonial__mark" aria-hidden="true">“</span>La masticada con Rodrigo fue una experiencia transformadora para nuestro equipo. Se generó un espacio para compartir experiencias muy enriquecedoras sobre La Bestia que permitieron potenciar la forma en la que nos complementamos y establecer un marco de referencia común para el futuro. A través de las reflexiones de Rodrigo, cada uno del equipo pudo verse reflejado en distintas situaciones personales y compartir sus perspectivas. El equipo salió súper motivado y más conectado de la masticada.
                </blockquote>
                <figcaption class="mm-testimonial__cite">
                    <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/joaco.jpeg"}}"
                            alt="Joaquín Fernández, Socio en Fernández Secco &amp; Asociados"
                            class="mm-testimonial__avatar-img"
                            width="120"
                            height="120"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-testimonial__person">
                        <span class="mm-testimonial__name">Joaquín Fernández</span>
                        <span class="mm-testimonial__role">Socio en Fernández Secco &amp; Asociados</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- 6. Bocados (compacto) --------------------------------------------- --}}
    <section class="mm-bocados" aria-labelledby="bocados-title">
        <div class="mm-canvas">
            <div class="mm-bocados__panel">
                <div class="mm-bocados__row">
                    <div class="mm-bocados__text">
                        <p class="mm-eyebrow">Newsletter</p>
                        <h2 class="mm-bocados__title" id="bocados-title">Bocados para masticar.</h2>
                        <p class="mm-bocados__lede">
                            Textos cortos sobre la voz que nos frena y el fuego que, cada tanto, se enciende. Cada miércoles, por mail.
                        </p>
                        <div class="mm-actions">
                            {{#get "posts" limit="1" as |latest|}}
                                {{#foreach latest}}
                                    <a href="{{url}}" class="mm-btn mm-btn--ghost">Leer el último bocado</a>
                                {{/foreach}}
                            {{else}}
                                <a href="/" class="mm-btn mm-btn--ghost">Leer bocados</a>
                            {{/get}}
                        </div>
                    </div>

                    {{#if @site.members_enabled}}
                        {{#unless @site.members_invite_only}}
                            {{#unless @member}}
                                <form class="mm-bocados__form" data-members-form>
                                    <label for="mm-bocados-email" class="mm-visually-hidden">Tu email</label>
                                    <p class="mm-bocados__form-label">Recibilos antes que nadie</p>
                                    <div class="mm-bocados__field">
                                        <input
                                            id="mm-bocados-email"
                                            class="mm-bocados__input"
                                            type="email"
                                            name="email"
                                            data-members-email
                                            placeholder="tu@email.com"
                                            required="true"
                                        >
                                        <button class="mm-bocados__btn" type="submit" aria-label="Suscribirse a Bocados">
                                            Recibirlos
                                        </button>
                                    </div>
                                    <p class="mm-bocados__note">
                                        Sin spam. El primero de cada mes es exclusivo para suscriptores.
                                    </p>
                                    <p class="error-message"></p>
                                    <p class="success-message"></p>
                                </form>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{!-- 7. Contacto -------------------------------------------------------- --}}
    <section class="mm-home-contact" id="mm-home-contact" aria-labelledby="home-contact-title">
        <div class="mm-canvas">
            <div class="mm-home-contact__panel">
                <header class="mm-home-contact__header">
                    <p class="mm-eyebrow">Escribime</p>
                    <h2 class="mm-v2-title mm-home-contact__title" id="home-contact-title">
                        Contame qué necesitás, y lo <span class="mm-accent">pensamos juntos.</span>
                    </h2>
                </header>

                <form
                    id="mm-home-formspree"
                    class="mm-home-contact__form"
                    action="https://formspree.io/f/maqpeljq"
                    method="POST"
                >
                    <input type="hidden" name="_subject" value="Contacto — desde la home">
                    <input type="hidden" name="origen" value="home">

                    <fieldset class="mm-home-contact__choice">
                        <legend class="mm-home-contact__choice-legend">¿Sobre qué querés hablar?</legend>
                        <div class="mm-home-contact__choice-options">
                            <label class="mm-home-contact__choice-option">
                                <input type="radio" name="tipo_consulta" value="Algo para mi equipo" required>
                                <span>Algo para mi equipo</span>
                            </label>
                            <label class="mm-home-contact__choice-option">
                                <input type="radio" name="tipo_consulta" value="Algo para mí como líder">
                                <span>Algo para mí como líder</span>
                            </label>
                            <label class="mm-home-contact__choice-option">
                                <input type="radio" name="tipo_consulta" value="Una charla para mi evento">
                                <span>Una charla para mi evento</span>
                            </label>
                            <label class="mm-home-contact__choice-option">
                                <input type="radio" name="tipo_consulta" value="Otro">
                                <span>Otro</span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="mm-home-contact__row mm-home-contact__row--two">
                        <div class="mm-home-contact__field">
                            <label class="mm-home-contact__label" for="mm-home-name">Nombre</label>
                            <input
                                id="mm-home-name"
                                name="nombre"
                                type="text"
                                autocomplete="name"
                                required
                                class="mm-home-contact__input"
                            >
                        </div>

                        <div class="mm-home-contact__field">
                            <label class="mm-home-contact__label" for="mm-home-email">Email</label>
                            <input
                                id="mm-home-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="mm-home-contact__input"
                            >
                        </div>
                    </div>

                    <div class="mm-home-contact__row">
                        <div class="mm-home-contact__field">
                            <label class="mm-home-contact__label" for="mm-home-message">Contame de tu situación</label>
                            <textarea
                                id="mm-home-message"
                                name="mensaje"
                                rows="6"
                                required
                                placeholder="¿Qué estás masticando?"
                                class="mm-home-contact__textarea"
                            ></textarea>
                        </div>
                    </div>

                    {{!-- Honeypot --}}
                    <div class="mm-home-contact__honeypot" aria-hidden="true">
                        <label for="mm-home-website">No completar este campo</label>
                        <input id="mm-home-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="mm-actions">
                        <button type="submit" class="mm-btn mm-btn--primary mm-btn--lg">
                            Enviar mensaje
                        </button>
                    </div>

                    <p id="mm-home-form-status" class="mm-home-contact__status" role="status" aria-live="polite"></p>

                    <p class="mm-home-contact__fallback">
                        También podés escribirme a
                        <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                    </p>
                </form>
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2{{/contentFor}}

{{!-- AJAX submit for home contact form. Same pattern as /masticadas. --}}
<script>
(function () {
    var form = document.getElementById('mm-home-formspree');
    if (!form) return;
    var status = document.getElementById('mm-home-form-status');
    var submitBtn = form.querySelector('button[type="submit"]');

    function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg;
        status.dataset.state = state || '';
    }

    {{!-- Allow other pages to deep-link with /?tipo=masticada#mm-home-contact
         The querystring goes BEFORE the fragment so the browser still scrolls
         to the form (the # value must be a real element id). We read tipo
         from location.search, not from the hash. --}}
    function preselectFromUrl() {
        try {
            var search = window.location.search || '';
            var match = search.match(/[?&]tipo=([^&]+)/);
            if (!match) return;
            var requested = decodeURIComponent(match[1]).toLowerCase();
            var map = {
                'equipo':       'Algo para mi equipo',
                'capacitacion': 'Algo para mi equipo',
                'capacitación': 'Algo para mi equipo',
                'masticada':    'Algo para mi equipo',
                'lider':        'Algo para mí como líder',
                'líder':        'Algo para mí como líder',
                'sesion':       'Algo para mí como líder',
                'sesión':       'Algo para mí como líder',
                'charla':       'Una charla para mi evento',
                'otro':         'Otro'
            };
            var target = map[requested];
            if (!target) return;
            var radios = form.querySelectorAll('input[name="tipo_consulta"]');
            for (var i = 0; i < radios.length; i++) {
                if (radios[i].value === target) {
                    radios[i].checked = true;
                    break;
                }
            }
        } catch (e) { /* noop */ }
    }
    preselectFromUrl();

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.dataset.label = submitBtn.textContent;
            submitBtn.textContent = 'Enviando…';
        }
        setStatus('', 'loading');

        var data = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (res.ok) {
                form.reset();
                setStatus('Gracias. Ya recibí tu mensaje. Te voy a leer con atención y te respondo pronto.', 'success');
            } else {
                return res.json().then(function (body) {
                    var msg = (body && body.errors && body.errors[0] && body.errors[0].message)
                        || 'Algo no funcionó. Probá de nuevo en un momento.';
                    setStatus(msg, 'error');
                }).catch(function () {
                    setStatus('Algo no funcionó. Probá de nuevo en un momento.', 'error');
                });
            }
        }).catch(function () {
            setStatus('No pudimos enviar el mensaje. Revisá tu conexión y probá de nuevo.', 'error');
        }).finally(function () {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.label || 'Enviar mensaje';
            }
        });
    });
})();
</script>
