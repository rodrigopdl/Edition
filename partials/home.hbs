{{!< default}}

<main class="homepage-main mm-v2">

    {{!-- 1. Hero ------------------------------------------------------------ --}}
    <section class="mm-v2-hero" aria-labelledby="hero-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <h1 class="mm-hero__title" id="hero-title">
                    <span class="mm-hero__title-main">Despierto <span class="mm-accent">autoliderazgo.</span></span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Historias, preguntas que dejan masticando y un lenguaje que se queda.</p>
                </div>

                <div class="mm-actions mm-actions--center">
                    <a href="/viaje/" class="mm-btn mm-btn--primary mm-btn--lg">
                        Un viaje para tu equipo
                        <span aria-hidden="true">→</span>
                    </a>
                    <a href="/bocados/" class="mm-btn mm-btn--ghost mm-btn--lg">
                        Leer los bocados
                    </a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. Cover: Panorama + Servicio superpuestos ------------------------
         El panorama de Rodri frente al mar arranca justo después del hero.
         La sección del Viaje se renderiza encima del panorama con
         posicionamiento absoluto y fondo transparente, dejando ver la
         imagen detrás. --}}
    <div class="mm-home-cover">
        <section class="mm-home-panorama mm-home-panorama--bleed mm-home-panorama--cover" aria-hidden="true">
            <figure class="mm-home-panorama__figure">
                <div class="mm-home-panorama__frame">
                    <img
                        src="{{asset "images/rodri-mar-full-3.webp"}}"
                        alt="Rodri de espaldas frente al mar, con su libro La Bestia en las manos."
                        class="mm-home-panorama__img"
                        loading="lazy"
                    >
                </div>
            </figure>
        </section>

        <section class="mm-ways mm-home-service mm-home-service--over-cover" id="mm-home-ways" aria-labelledby="ways-title">
            <div class="mm-canvas mm-canvas--narrow">
                <header class="mm-section-header mm-home-service__header">
                    <h2 class="mm-v2-title mm-home-service__title" id="ways-title">
                        El viaje Para masticar.
                    </h2>
                </header>

                <div class="mm-home-service__body">
                    <p class="mm-home-service__text">
                        Un programa de varias semanas para despertar el autoliderazgo de tu equipo.
                    </p>
                    <div class="mm-actions">
                        <a href="/viaje/" class="mm-btn mm-btn--primary mm-btn--lg">
                            Ver las cinco piezas
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    {{!-- 3. Bocados (newsletter) — antes de Quién soy ---------------------- --}}
    <section class="mm-bocados" id="mm-home-bocados" aria-labelledby="bocados-title">
        <div class="mm-canvas">
            <div class="mm-bocados__panel">
                <div class="mm-bocados__row">
                    <div class="mm-bocados__text">
                        <p class="mm-eyebrow">Para masticar</p>
                        <h2 class="mm-bocados__title" id="bocados-title">Los <span class="mm-accent">bocados.</span></h2>
                        <p class="mm-bocados__lede">
                            Podés entrar a mi mundo por donde entró todo el mundo: los bocados. Textos cortos que te dejan pensando. Cada miércoles, por mail, gratis.
                        </p>
                    </div>

                    {{#if @site.members_enabled}}
                        {{#unless @site.members_invite_only}}
                            {{#unless @member}}
                                <form class="mm-bocados__form" data-members-form>
                                    <label for="mm-bocados-email" class="mm-visually-hidden">Tu email</label>
                                    <p class="mm-bocados__form-label">Recibilos antes que nadie</p>
                                    <div class="mm-bocados__field">
                                        <input
                                            id="mm-bocados-email"
                                            class="mm-bocados__input"
                                            type="email"
                                            name="email"
                                            data-members-email
                                            placeholder="tu@email.com"
                                            required="true"
                                        >
                                        <button class="mm-bocados__btn" type="submit" aria-label="Suscribirse a Bocados">
                                            Recibirlos
                                        </button>
                                    </div>
                                    <p class="mm-bocados__note">
                                        Sin spam. El primero de cada mes es exclusivo para suscriptores.
                                    </p>
                                    <p class="error-message"></p>
                                    <p class="success-message"></p>

                                    <div class="mm-bocados__cta-secondary">
                                        {{#get "posts" limit="1" as |latest|}}
                                            {{#foreach latest}}
                                                <a href="{{url}}" class="mm-btn mm-btn--ghost">Leer el último</a>
                                            {{/foreach}}
                                        {{else}}
                                            <a href="/" class="mm-btn mm-btn--ghost">Leer bocados</a>
                                        {{/get}}
                                    </div>
                                </form>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{!-- 4. Quién soy — Hola, soy Rodri ------------------------------------- --}}
    <section class="mm-intro" aria-labelledby="intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri"
                            class="mm-intro__img"
                            width="900"
                            height="1100"
                            loading="lazy"
                        >
                    </div>
                </figure>

                <div class="mm-intro__text">
                    <p class="mm-eyebrow">Acerca</p>
                    <h2 class="mm-v2-title" id="intro-title">
                        Hola, <span class="mm-accent">soy Rodri.</span>
                    </h2>
                    <div class="mm-prose mm-prose--intro">
                        <p>Vengo del mundo de la programación: soy licenciado en sistemas y durante más de una década trabajé en WyeWorks, una consultora de software uruguaya con una cultura de trabajo fuera de serie. Empecé como desarrollador y, con los años, me convertí en acompañante estratégico del CEO.</p>
                        <p>En el camino descubrí que los problemas más difíciles casi nunca eran técnicos, sino humanos. Y que empezaban por mí: por esa fuerza interior que me frenaba y me hacía ver problemas donde no los había. Le puse un nombre —<em>La Bestia</em>— y, de a poco, aprendí a domarla.</p>
                        <p>Comparto lo que encuentro en mi propia búsqueda, no una fórmula de experto. Así nació Para masticar, y con el tiempo se volvió un libro, charlas y el Viaje. Hoy lo que más me entusiasma es despertar ese mismo autoliderazgo en un equipo entero.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 4b. Testimonio José Costa — aval de la bio.
         Mismo componente/estilo que en /lideres/. --}}
    <section class="mm-testimonial" aria-labelledby="testimonial-title">
        <div class="mm-canvas">
            <p class="mm-eyebrow mm-eyebrow--muted">Testimonio</p>
            <figure class="mm-testimonial__figure">
                <blockquote class="mm-testimonial__quote" id="testimonial-title">
                    <span class="mm-testimonial__mark" aria-hidden="true">“</span>Rodri fue una de las voces que más nos ayudó a pensar sobre quiénes somos como organización y qué tipo de empresa queríamos construir. Su capacidad para articular ideas sobre liderazgo, autonomía, cultura y desarrollo humano generó conversaciones valiosas que dejaron huella en muchas personas dentro de WyeWorks.
                </blockquote>
                <figcaption class="mm-testimonial__cite">
                    <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/Jose.webp"}}"
                            alt="José, Founder &amp; CEO de WyeWorks"
                            class="mm-testimonial__avatar-img"
                            width="120"
                            height="120"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-testimonial__person">
                        <span class="mm-testimonial__name">José Costa</span>
                        <span class="mm-testimonial__role">Co-founder &amp; CEO, WyeWorks</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- 5. La Bestia ------------------------------------------------------- --}}
    <section class="mm-bestia" aria-labelledby="bestia-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-bestia__grid">
                <div class="mm-bestia__visual">
                    <img
                        src="{{asset "images/cover-es-720.webp"}}"
                        srcset="{{asset "images/cover-es-720.webp"}} 720w, {{asset "images/cover-es-1080.webp"}} 1080w"
                        sizes="240px"
                        alt="La Bestia, libro de Rodri"
                        class="mm-bestia__book"
                        loading="lazy"
                        width="720"
                        height="1152"
                    >
                </div>
                <div class="mm-bestia__text">
                    <p class="mm-eyebrow">El libro</p>
                    <h2 class="mm-v2-title" id="bestia-title">
                        <span class="mm-accent">La Bestia.</span>
                    </h2>
                    <div class="mm-prose">
                        <p>Gran parte de mi trabajo nace de una idea: todos tenemos una Bestia. Esa fuerza interior que nos frena, nos hace dudar, y nos aleja de la persona que queremos ser.</p>
                        <p>Aprender a reconocerla y a domarla es el camino para liderarnos a nosotros mismos. De eso trata mi libro.</p>
                    </div>
                    <div class="mm-actions">
                        <a href="/bestia/" class="mm-btn mm-btn--ghost">Conocé el libro</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 7. Contacto -------------------------------------------------------- --}}

    <section class="mm-home-contact" id="mm-home-contact" aria-labelledby="home-contact-title">
        <div class="mm-canvas">
            <div class="mm-home-contact__panel">
                <header class="mm-home-contact__header">
                    <p class="mm-eyebrow">Escribime</p>
                    <h2 class="mm-v2-title mm-home-contact__title" id="home-contact-title">
                        Contame qué necesitás, y lo <span class="mm-accent">pensamos juntos.</span>
                    </h2>
                </header>

                {{> "contact-form" show_selector=true origen="home" subject="Contacto — desde la home"}}

                <p class="mm-home-contact__fallback">
                    También podés escribirme a
                    <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                </p>
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2{{/contentFor}}
