{{!< default}}

<main class="homepage-main">

    {{!-- Hero Section --}}
    <section class="mm-hero">
        <div class="mm-hero-content gh-canvas">
            <h1 class="mm-hero-title"><span class="accent-word">Una pausa semanal</span> para frenar y pensar mejor.</h1>
            
            <div class="mm-hero-grid">
                {{!-- Left: Image/Visual --}}
                <div class="mm-hero-visual">
                    <img src="{{asset "images/plate-cool.png"}}" alt="Newsletter Preview" class="mm-hero-image" width="450" height="450" loading="eager">
                </div>
                
                {{!-- Right: Form and Description --}}
                <div class="mm-hero-form-section">
                    <div class="mm-hero-stat">
                        <span class="mm-hero-text">Cada miércoles, un <em>bocado</em> que se lee rápido pero se queda con vos.</span>
                    </div>
                    
                    <p class="mm-hero-description">Y el primero de cada mes, uno que <strong class="mm-hand-circle">solo llega por email</strong>.</p>
                    
                    {{!-- Newsletter CTA --}}
                    {{#if @site.members_enabled}}
                        {{#unless @site.members_invite_only}}
                            {{#unless @member}}
                                <form class="mm-newsletter-form" data-members-form>
                                    <div class="mm-form-wrapper">
                                        <input class="mm-email-input" type="email" name="email" data-members-email placeholder="Tu email aquí" required="true">
                                        <button class="mm-submit-btn" type="submit" aria-label="Suscribirse">
                                            Quiero el próximo
                                        </button>
                                    </div>
                                    <p class="mm-privacy-note">Tu información está protegida y nunca envío spam.</p>
                                    <p class="error-message"></p>
                                    <p class="success-message"></p>
                                </form>
                            {{else}}
                                <div class="mm-member-welcome">
                                    <p>¡Bienvenido! Ya estás suscrito a Para masticar.</p>
                                    <a href="#/portal/account" class="mm-account-link" data-portal="account">Ver mi cuenta</a>
                                </div>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{!-- Handpicked Posts Section - Best Posts for New Visitors --}}
    {{!-- First get the pinned/featured post --}}
    {{#get "posts" filter="tag:handpicked-featured" limit="1" as |pinnedPost|}}
        {{!-- Then get the other handpicked posts, excluding the featured one --}}
        {{#get "posts" filter="tag:handpicked+tag:-handpicked-featured" limit="2" as |regularPosts|}}
            {{#if pinnedPost}}
                {{> "handpicked-posts" pinnedPost=pinnedPost regularPosts=regularPosts}}
            {{else if regularPosts}}
                {{> "handpicked-posts" regularPosts=regularPosts}}
            {{/if}}
        {{/get}}
    {{/get}}

    {{!-- About Section --}}
    <section class="mm-about">
        <div class="mm-about-content gh-canvas">
            <h2 class="mm-about-title">Hola, <span class="accent-word">soy Rodri</span></h2>
            
            <div class="mm-about-grid">
                <div class="mm-about-text">
                    <div class="mm-about-description">
                        <p>Trabajo como <em>Insight Strategist</em> en WyeWorks.
Me interesa entender cómo pensamos, cómo decidimos y por qué a veces nos frenamos sin darnos cuenta.
Escribo sobre liderazgo, ruido interno y esas pequeñas cosas del día a día que, si las mirás de cerca, dicen más de lo que parece...</p>
                    </div>
                </div>
                <div class="mm-about-image">
                    <img src="{{asset "images/rodri3.jpg"}}" alt="{{@site.title}}" class="mm-profile-img" width="321" height="320" loading="lazy">
                </div>
            </div>
            
            <div class="mm-about-actions">
                <a href="/acerca" class="mm-action-link">Sobre Para Masticar</a>
            </div>
        </div>
    </section>

    {{!-- Book Promo Section --}}
    <section class="mm-book-promo">
        <div class="mm-book-content gh-canvas">
            <div class="mm-book-grid">
                <div class="mm-book-visual">
                    <div class="mm-book-image-wrapper">
                        <img src="{{asset "images/cover-es.jpg"}}" alt="La Bestia" class="mm-book-image" loading="lazy">
                    </div>
                </div>
                <div class="mm-book-text">
                    <h2 class="mm-book-title"><span class="accent-word">La Bestia</span></h2>
                    <p class="mm-book-description">23 bocados para ponerle nombre a esa voz que te frena.</p>
                    <a href="/bestia/" class="mm-book-link">Ver el libro</a>
                </div>
            </div>
        </div>
    </section>

    {{!-- Latest Post Section - Recién salido del horno --}}
    {{#get "posts" limit="1" as |latest|}}
        {{#foreach latest}}
            <section class="mm-latest-post">
                <div class="mm-latest-content gh-canvas">
                    <div class="mm-latest-grid">
                        {{!-- Left: Post Image --}}
                        <div class="mm-latest-image-container">
                            <a href="{{url}}" class="mm-latest-image-link">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="mm-latest-image" width="600" height="400" loading="eager">
                                {{else}}
                                    <div class="mm-latest-image-placeholder">
                                        <span class="mm-placeholder-text">{{title}}</span>
                                    </div>
                                {{/if}}
                            </a>
                        </div>
                        
                        {{!-- Right: Post Content --}}
                        <div class="mm-latest-text">
                            <h3 class="mm-latest-title">
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                            
                            <p class="mm-latest-excerpt">
                                {{#if custom_excerpt}}
                                    {{custom_excerpt}}...
                                {{else}}
                                    {{excerpt words="30"}}...
                                {{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        {{/foreach}}
    {{/get}}

    {{!-- Content Sections --}}
    <section class="mm-content-sections">
        <div class="mm-sections-wrapper">            
            {{!-- Últimos Bocados (Latest Posts) --}}
            {{#get "posts" limit="6" as |latest|}}
                {{> "post-list-section" posts=latest title="Últimos bocados"}}
            {{/get}}
            
            {{!-- Los Favoritos (Featured Posts Only) --}}
            {{#get "posts" filter="featured:true" limit="6" as |featured|}}
                {{#if featured}}
                    {{> "post-list-section" posts=featured title="Favoritos de la comunidad"}}
                {{/if}}
            {{/get}}
        </div>
    </section>

    {{> "bottom-cta"}}

</main>

{{!-- Custom body classes for homepage --}}
{{#contentFor "body_class"}}homepage-mm-style{{/contentFor}}
