{{!< default}}

<main class="homepage-main mm-v2">

    {{!-- 1. Hero --}}
    <section class="mm-v2-hero" aria-labelledby="hero-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <h1 class="mm-hero__title" id="hero-title">
                    Un lugar para frenar <span class="mm-accent">y pensar mejor.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Para ordenar lo que tenés en la cabeza, ver lo que quizás no estás viendo y pensar qué hacer con lo que tenés por delante.</p>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. Bocados — una sola aparición en la home: suscripción + último bocado
         + acceso al archivo. Editorial, sobre el fondo oscuro (no card crema).
         Dos columnas en desktop; apila en mobile. El formulario se oculta a
         miembros ya suscriptos, pero el último bocado y el archivo se ven siempre. --}}
    <section class="mm-boc-sub" id="bocados" aria-labelledby="boc-sub-title">
        <div class="mm-canvas">
            <div class="mm-boc-sub__inner">

                {{!-- Columna izquierda: suscripción (acción principal). --}}
                <div class="mm-boc-sub__subscribe">
                    <h2 class="mm-boc-sub__title" id="boc-sub-title">Un bocado cada <span class="mm-accent">miércoles.</span></h2>
                    <p class="mm-boc-sub__lede">Un texto corto para dejarte pensando.</p>

                    {{#if @site.members_enabled}}
                    {{#unless @site.members_invite_only}}
                    {{#unless @member}}
                    <form class="mm-boc-sub__form mm-bocados__form" data-members-form>
                        <label for="mm-boc-sub-email" class="mm-visually-hidden">Tu email</label>
                        <div class="mm-bocados__field">
                            <input
                                id="mm-boc-sub-email"
                                class="mm-bocados__input"
                                type="email"
                                name="email"
                                data-members-email
                                placeholder="nombre@email.com"
                                required="true"
                            >
                            <button class="mm-bocados__btn" type="submit" aria-label="Suscribirse a Bocados">
                                Quiero recibirlos
                            </button>
                        </div>
                        <p class="mm-boc-sub__note">Gratis, directo a tu correo.</p>
                        <p class="error-message"></p>
                        <p class="success-message"></p>
                    </form>
                    {{/unless}}
                    {{/unless}}
                    {{/if}}
                </div>

                {{!-- Columna derecha: muestra del contenido — último bocado (dinámico,
                     misma lógica que usaba la sección inferior) + link al archivo.
                     Imagen + "Último bocado" + título, todo clickeable. --}}
                <div class="mm-boc-sub__sample">
                    {{#get "posts" limit="1" as |latest|}}
                        {{#foreach latest}}
                            <a href="{{url}}" class="mm-boc-sub__latest">
                                {{#if feature_image}}
                                    <span class="mm-boc-sub__latest-media">
                                        <img
                                            src="{{img_url feature_image size="s"}}"
                                            srcset="{{img_url feature_image size="s"}} 1x, {{img_url feature_image size="m"}} 2x"
                                            alt="{{title}}"
                                            class="mm-boc-sub__latest-img"
                                            loading="lazy"
                                            width="320"
                                            height="200"
                                        >
                                    </span>
                                {{/if}}
                                <span class="mm-boc-sub__latest-body">
                                    <span class="mm-boc-sub__latest-eyebrow">Último bocado</span>
                                    <span class="mm-boc-sub__latest-title">{{title}}</span>
                                </span>
                            </a>
                        {{/foreach}}
                    {{/get}}

                    <a href="/bocados/" class="mm-boc-sub__archive-link">Ver todos los bocados <span aria-hidden="true">→</span></a>
                </div>

            </div>
        </div>
    </section>

    {{!-- 3. Formas de trabajar juntos — sube aquí (justo tras Bocados) para que
         las propuestas se descubran temprano, sobre todo en mobile. --}}
    <section class="mm-ways" id="mm-home-ways" aria-labelledby="ways-title">
        <div class="mm-canvas">
            <header class="mm-section-header mm-ways__header">
                <h2 class="mm-v2-title" id="ways-title">Otras formas de <span class="mm-accent">masticar.</span></h2>
            </header>

            {{!-- Equal proposals, in the same order on desktop and mobile. --}}
            <div class="mm-ways__grid mm-ways__grid--three">
                <article class="mm-way">
                    <h3 class="mm-way__title">Masticadas <span class="mm-way__title-accent">Para vos</span></h3>
                    <p class="mm-way__text mm-way__text--secondary">Para pensar a fondo sobre algo que te importa, con historias e ideas preparadas especialmente para nuestra conversación.</p>
                    <a href="/sesiones/" class="mm-way__link" aria-label="Conocé más sobre Masticadas para vos">Conocé más</a>
                </article>

                <article class="mm-way">
                    <h3 class="mm-way__title">Masticadas <span class="mm-way__title-accent">Para equipos</span></h3>
                    <p class="mm-way__text mm-way__text--secondary">Para que tu equipo converse sobre lo que está viviendo, comparta experiencias y se conozca mejor.</p>
                    <a href="/masticadas/" class="mm-way__link" aria-label="Conocé más sobre Masticadas para equipos">Conocé más</a>
                </article>

                <article class="mm-way">
                    <h3 class="mm-way__title">El Viaje <span class="mm-way__title-accent">Para masticar</span></h3>
                    <p class="mm-way__text mm-way__text--secondary">Un mes de masticadas y bocados para que tu equipo profundice en un tema que quiere trabajar.</p>
                    <a href="/viaje/" class="mm-way__link" aria-label="Conocé más sobre El Viaje Para masticar">Conocé más</a>
                </article>
            </div>
        </div>
    </section>

    {{!-- 4. Bio --}}
    <section class="mm-intro" aria-labelledby="intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri Ponce de León"
                            class="mm-intro__img"
                            width="800"
                            height="1200"
                            loading="lazy"
                        >
                    </div>
                </figure>

                <div class="mm-intro__text">
                    <h2 class="mm-v2-title" id="intro-title">
                        Hola, <span class="mm-accent">soy Rodri.</span>
                    </h2>
                    <div class="mm-prose mm-prose--intro">
                        <p>Durante más de una década trabajé en WyeWorks, una empresa de tecnología uruguaya. Empecé como desarrollador de software, después pasé a formar parte del equipo de managers y terminé como acompañante estratégico del CEO.</p>
                        <p>En ese camino entendí que muchos de los problemas más difíciles no eran técnicos. Eran humanos. Y muchas veces empezaban por uno mismo.</p>
                        <p>Eso me llevó a leer, escribir y prestar más atención a cómo pensamos, qué nos frena y cómo influimos en los demás. Con el tiempo fui construyendo mi propia forma de mirar estas cosas.</p>
                        <p>Así fue tomando forma Para masticar. Primero como un lugar para compartir historias e ideas y después como una forma de ayudar a otras personas a pensar mejor.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 5. Testimonio --}}
    <section class="mm-testimonial" aria-labelledby="testimonial-title">
        <div class="mm-canvas">
            <figure class="mm-testimonial__figure">
                <blockquote class="mm-testimonial__quote" id="testimonial-title">
                    <span class="mm-testimonial__mark" aria-hidden="true">“</span>Rodri fue una de las voces que más nos ayudó a pensar sobre quiénes somos como organización y qué tipo de empresa queríamos construir. Su capacidad para articular ideas sobre liderazgo, autonomía, cultura y desarrollo humano generó conversaciones valiosas que dejaron huella en muchas personas dentro de WyeWorks.
                </blockquote>

                <figcaption class="mm-testimonial__cite">
                    <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/Jose.webp"}}"
                            alt="José Costa, Co-founder y CEO de WyeWorks"
                            class="mm-testimonial__avatar-img"
                            width="120"
                            height="120"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-testimonial__person">
                        <span class="mm-testimonial__name">José Costa</span>
                        <span class="mm-testimonial__role">Co-founder &amp; CEO, WyeWorks</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- 5. La Bestia --}}
    <section class="mm-bestia" aria-labelledby="bestia-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-bestia__grid">
                <div class="mm-bestia__visual">
                    <img
                        src="{{asset "images/cover-es-720.webp"}}"
                        srcset="{{asset "images/cover-es-720.webp"}} 720w, {{asset "images/cover-es-1080.webp"}} 1080w"
                        sizes="240px"
                        alt="La Bestia, libro de Rodri Ponce de León"
                        class="mm-bestia__book"
                        loading="lazy"
                        width="720"
                        height="1152"
                    >
                </div>
                <div class="mm-bestia__text">
                    <h2 class="mm-v2-title" id="bestia-title">
                        <span class="mm-accent">La Bestia.</span>
                    </h2>
                    <div class="mm-prose">
                        <p>Todos tenemos una Bestia.</p>
                        <p>Esa parte de nosotros que aparece cuando algo se pone difícil y trata de convencernos de reaccionar, evitar, postergar o elegir el camino fácil.</p>
                        <p>No podemos hacerla desaparecer. Pero podemos aprender a reconocerla antes de que decida por nosotros.</p>
                        <p>De eso trata La Bestia, mi libro.</p>
                    </div>
                    <div class="mm-actions mm-bestia__actions">
                        <a href="/bestia/" class="mm-btn mm-btn--ghost">Conocer el libro</a>
                        <p class="mm-bestia__rating">
                            <span class="mm-bestia__stars" aria-hidden="true">★★★★★</span>
                            <span class="mm-bestia__rating-text">5,0 en Amazon</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 6. Hablemos --}}
    <section class="mm-home-contact" id="mm-home-contact" aria-labelledby="home-contact-title">
        <div class="mm-canvas">
            <div class="mm-home-contact__panel">
                <header class="mm-home-contact__header">
                    <h2 class="mm-v2-title mm-home-contact__title" id="home-contact-title">
                        <span class="mm-accent">Hablemos.</span>
                    </h2>
                    <p class="mm-home-contact__subhead">
                      Contame qué te trae por acá. No hace falta que tengas claro por dónde empezar.
                    </p>
                </header>

                {{> "contact-form" show_selector=true origen="home" subject="Contacto — desde la home"}}

                <p class="mm-home-contact__fallback">
                    También podés escribirme a
                    <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                </p>
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2{{/contentFor}}
