{{!< default}}

<main class="homepage-main">

    {{!-- Hero Section - Mark Manson Style --}}
    <section class="mm-hero">
        <div class="mm-hero-content gh-canvas">
            <h1 class="mm-hero-title">Un <span class="accent-word">bocado</span> te puede cambiar la vida</h1>
            
            <div class="mm-hero-grid">
                {{!-- Left: Image/Visual --}}
                <div class="mm-hero-visual">
                    <img src="{{asset "images/newsletter-phones2.png"}}" alt="Newsletter Preview" class="mm-hero-image">
                </div>
                
                {{!-- Right: Form and Description --}}
                <div class="mm-hero-form-section">
                    <div class="mm-hero-stat">
                        <span class="mm-hero-text">MILES YA <span class="accent-word">ENCONTRARON CLARIDAD</span> EN UN BOCADO. EL PRÓXIMO PUEDE SER EL TUYO.</span>
                    </div>
                    
                    <p class="mm-hero-description">Bocados breves para líderes, emprendedores y buscadores de sentido. Uno por semana, directo a tu bandeja de entrada.</p>
                    
                    {{!-- Newsletter CTA --}}
                    {{#if @site.members_enabled}}
                        {{#unless @site.members_invite_only}}
                            {{#unless @member}}
                                <form class="mm-newsletter-form" data-members-form>
                                    <div class="mm-form-wrapper">
                                        <input class="mm-email-input" type="email" name="email" data-members-email placeholder="Tu email aquí" required="true">
                                        <button class="mm-submit-btn" type="submit" aria-label="Suscribirse">
                                            <span class="btn-text">SUSCRIBIRSE</span>
                                            <span class="btn-loader">{{> "icons/loader"}}</span>
                                            <span class="btn-success">¡Listo!</span>
                                        </button>
                                    </div>
                                    <p class="mm-privacy-note">Tu información está protegida y nunca envío spam.</p>
                                </form>
                            {{else}}
                                <div class="mm-member-welcome">
                                    <p>¡Bienvenido! Ya estás suscrito a Para masticar.</p>
                                    <a href="#/portal/account" class="mm-account-link" data-portal="account">Ver mi cuenta</a>
                                </div>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{!-- About Section - Mark Manson Style --}}
    <section class="mm-about">
        <div class="mm-about-content gh-canvas">
            <h2 class="mm-about-title">Hola, soy Rodri</h2>
            
            <div class="mm-about-grid">
                <div class="mm-about-text">
                    <div class="mm-about-description">
                        <p>En 2018 descubrí que liderar no era tener respuestas, sino hacerse mejores preguntas. Desde entonces escribo para quienes están al frente de algo: un equipo, un proyecto, una vida con intención. Si alguna vez sentiste que hay una Bestia dentro tuyo o que liderar es caminar entre niebla, capaz este espacio te acompañe.</p>
                    </div>
                </div>
                <div class="mm-about-image">
                    <img src="{{asset "images/avatar.png"}}" alt="{{@site.title}}" class="mm-profile-img">
                </div>
            </div>
            
            <div class="mm-about-actions">
                <a href="/bocados" class="mm-action-link">Leé mis bocados</a>
                <a href="https://youtube.com/@paramasticar?si=hxlreYn3YGllakjm" class="mm-action-link" target="_blank" rel="noopener noreferrer">Mirá mis videos</a>
            </div>
        </div>
    </section>

    {{!-- Content Sections - Mark Manson Style --}}
    <section class="mm-content-sections">
        <div class="mm-sections-wrapper">            
            {{!-- Últimos Bocados (Latest Posts) --}}
            {{#get "posts" limit="6" as |latest|}}
                {{> "post-list-section" posts=latest title="Recién salidos del horno"}}
            {{/get}}
            
            {{!-- Los Favoritos (Featured Posts Only) --}}
            {{#get "posts" filter="featured:true" limit="6" as |featured|}}
                {{#if featured}}
                    {{> "post-list-section" posts=featured title="Favoritos de la comunidad"}}
                {{/if}}
            {{/get}}
        </div>
    </section>

    {{> "bottom-cta"}}

</main>

{{!-- Custom body classes for homepage --}}
{{#contentFor "body_class"}}homepage-mm-style{{/contentFor}}
