{{!< default}}

<main class="homepage-main">

    {{!-- Hero Section --}}
    <section class="mm-hero">
        <div class="mm-hero-content gh-canvas">
            <h1 class="mm-hero-title">Bocados <span class="accent-word">para masticar...</span></h1>
            
            <div class="mm-hero-grid">
                {{!-- Left: Image/Visual --}}
                <div class="mm-hero-visual">
                    <img src="{{asset "images/hiker-plate.png"}}" alt="Newsletter Preview" class="mm-hero-image">
                </div>
                
                {{!-- Right: Form and Description --}}
                <div class="mm-hero-form-section">
                    <div class="mm-hero-stat">
                        <span class="mm-hero-text">TEXTOS BREVES QUE INVITAN A PAUSAR, PENSAR Y AVANZAR CON SENTIDO.</span>
                    </div>
                    
                    <p class="mm-hero-description">Recibilos los miércoles en tu bandeja de entrada.</p>
                    
                    {{!-- Newsletter CTA --}}
                    {{#if @site.members_enabled}}
                        {{#unless @site.members_invite_only}}
                            {{#unless @member}}
                                <form class="mm-newsletter-form" data-members-form>
                                    <div class="mm-form-wrapper">
                                        <input class="mm-email-input" type="email" name="email" data-members-email placeholder="Tu email aquí" required="true">
                                        <button class="mm-submit-btn" type="submit" aria-label="Suscribirse">
                                            SUSCRIBITE
                                        </button>
                                    </div>
                                    <p class="mm-privacy-note">Tu información está protegida y nunca envío spam.</p>
                                    <p class="error-message"></p>
                                    <p class="success-message"></p>
                                </form>
                            {{else}}
                                <div class="mm-member-welcome">
                                    <p>¡Bienvenido! Ya estás suscrito a Para masticar.</p>
                                    <a href="#/portal/account" class="mm-account-link" data-portal="account">Ver mi cuenta</a>
                                </div>
                            {{/unless}}
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
        </div>
    </section>

    {{!-- Latest Post Section - Recién salido del horno --}}
    {{#get "posts" limit="1" as |latest|}}
        {{#foreach latest}}
            <section class="mm-latest-post">
                <div class="mm-latest-content gh-canvas">
                    <div class="mm-latest-grid">
                        {{!-- Left: Post Image --}}
                        <div class="mm-latest-image-container">
                            <a href="{{url}}" class="mm-latest-image-link">
                                {{#if feature_image}}
                                    <img src="{{img_url feature_image size="m"}}" alt="{{title}}" class="mm-latest-image">
                                {{else}}
                                    <div class="mm-latest-image-placeholder">
                                        <span class="mm-placeholder-text">{{title}}</span>
                                    </div>
                                {{/if}}
                            </a>
                        </div>
                        
                        {{!-- Right: Post Content --}}
                        <div class="mm-latest-text">
                            <h3 class="mm-latest-title">
                                <a href="{{url}}">{{title}}</a>
                            </h3>
                            
                            <p class="mm-latest-excerpt">
                                {{#if custom_excerpt}}
                                    {{custom_excerpt}}...
                                {{else}}
                                    {{excerpt words="30"}}...
                                {{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        {{/foreach}}
    {{/get}}

    {{!-- About Section --}}
    <section class="mm-about">
        <div class="mm-about-content gh-canvas">
            <h2 class="mm-about-title">Hola, soy Rodri</h2>
            
            <div class="mm-about-grid">
                <div class="mm-about-text">
                    <div class="mm-about-description">
                        <p>En 2018 entendí algo que me cambió para siempre: si quería liderar a otros, 
                            primero tenía que aprender a <span class="accent-word">liderarme a mí mismo</span>.</span> Desde entonces escribo 
                            sobre ese camino: el de entenderse, domar las emociones y avanzar con sentido. 
                            Si estás buscando vivir con intención, quizás mis bocados te acompañen en ese viaje. 
                            </p>
                    </div>
                </div>
                <div class="mm-about-image">
                    <img src="{{asset "images/rodri.webp"}}" alt="{{@site.title}}" class="mm-profile-img">
                </div>
            </div>
            
            <div class="mm-about-actions">
                <a href="/bocados" class="mm-action-link">Leé mis bocados</a>
                <a href="https://youtube.com/@paramasticar?si=hxlreYn3YGllakjm" class="mm-action-link" target="_blank" rel="noopener noreferrer">Mirá mis videos</a>
            </div>
        </div>
    </section>

    {{!-- Content Sections --}}
    <section class="mm-content-sections">
        <div class="mm-sections-wrapper">            
            {{!-- Últimos Bocados (Latest Posts) --}}
            {{#get "posts" limit="6" as |latest|}}
                {{> "post-list-section" posts=latest title="Últimos bocados"}}
            {{/get}}
            
            {{!-- Los Favoritos (Featured Posts Only) --}}
            {{#get "posts" filter="featured:true" limit="6" as |featured|}}
                {{#if featured}}
                    {{> "post-list-section" posts=featured title="Favoritos de la comunidad"}}
                {{/if}}
            {{/get}}
        </div>
    </section>

    {{> "bottom-cta"}}

</main>

{{!-- Custom body classes for homepage --}}
{{#contentFor "body_class"}}homepage-mm-style{{/contentFor}}
