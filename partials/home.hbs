{{!< default}}

<main class="homepage-main mm-v2 mm-home-refresh">

    {{!-- A continuous opening: purpose and team experience. --}}
    <div class="mm-home-opening">
        <section class="mm-v2-hero" aria-labelledby="hero-title">
            <div class="mm-canvas mm-canvas--wide">
                <div class="mm-hero__inner">
                    <h1 class="mm-hero__title" id="hero-title">
                        <span class="mm-home-hero__line">Hagamos de la</span>
                        <span class="mm-home-hero__line">reflexión <span class="mm-accent">un hábito.</span></span>
                    </h1>
                </div>
            </div>
        </section>

        <section class="mm-home-offers" id="mm-home-ways" aria-labelledby="home-masticadas-title">
            <div class="mm-canvas">
                <div class="mm-home-masticadas">
                    <div class="mm-ceramic">
                        <div class="mm-ceramic__content">
                            <p><span class="mm-ceramic__music">Música.</span><span class="mm-ceramic__stories">Historias.</span><span class="mm-ceramic__conversation">Buenas<br>conversaciones.</span></p>
                        </div>
                    </div>

                    <div class="mm-home-masticadas__copy">
                        <h2 id="home-masticadas-title">Las masticadas.</h2>
                        <p class="mm-home-masticadas__subtitle">90 minutos para conectar como equipo.</p>
                        <p class="mm-home-offer__description">Una experiencia grupal para reflexionar, conversar y entenderse mejor.</p>
                        <a href="/masticadas/" class="mm-btn mm-btn--primary mm-home-offer__cta">Conocé las masticadas</a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    {{!-- 3. Bio --}}
    <section class="mm-intro" aria-labelledby="intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri Ponce de León"
                            class="mm-intro__img"
                            width="800"
                            height="1200"
                            loading="lazy"
                        >
                    </div>
                </figure>

                <div class="mm-intro__text">
                    <h2 class="mm-v2-title" id="intro-title">
                        Hola, <span class="mm-accent">soy Rodri.</span>
                    </h2>
                    <div class="mm-prose mm-prose--intro">
                        <p>Durante más de diez años trabajé en WyeWorks, una consultora de software uruguaya. Empecé como desarrollador, después lideré equipos y terminé trabajando codo a codo con el CEO, ayudándolo a pensar los desafíos de la empresa.</p>
                        <p>En ese camino descubrí que los problemas más difíciles rara vez eran técnicos. Tenían que ver con las personas, con lo que nos pasa por dentro y cómo eso influye en nuestra manera de relacionarnos.</p>
                        <p>Y fui descubriendo cuánto ayuda detenernos a reflexionar para entender mejor lo que nos pasa. Sobre todo cuando lo hacemos con otros, compartiendo lo que pensamos y escuchando otras maneras de ver las cosas.</p>
                        <p>Por eso creé <em>Para masticar</em>: para ayudar a personas y equipos a hacer de la reflexión un hábito.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 5. Testimonio --}}
    <section class="mm-testimonial" aria-labelledby="testimonial-title">
        <div class="mm-canvas">
            <figure class="mm-testimonial__figure">
                <blockquote class="mm-testimonial__quote" id="testimonial-title">
                    <span class="mm-testimonial__mark" aria-hidden="true">“</span>Su capacidad para articular ideas sobre liderazgo, autonomía, cultura y desarrollo humano generó conversaciones valiosas que dejaron huella en muchas personas dentro de WyeWorks.
                </blockquote>

                <figcaption class="mm-testimonial__cite">
                    <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/Jose.webp"}}"
                            alt="José Costa, Co-founder y CEO de WyeWorks"
                            class="mm-testimonial__avatar-img"
                            width="120"
                            height="120"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-testimonial__person">
                        <span class="mm-testimonial__name">José Costa</span>
                        <span class="mm-testimonial__role">Co-founder &amp; CEO, WyeWorks</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- 4. Bocados: suscripción y último publicado --}}
    <section class="mm-boc-sub" id="bocados" aria-labelledby="boc-sub-title">
        <div class="mm-canvas">
            <div class="mm-boc-sub__inner">

                {{!-- Columna izquierda: suscripción (acción principal). --}}
                <div class="mm-boc-sub__subscribe">
                    <h2 class="mm-boc-sub__title" id="boc-sub-title">Un bocado cada <span class="mm-accent">miércoles.</span></h2>
                    <p class="mm-boc-sub__lede">Un texto corto para dejarte pensando.</p>

                    {{#if @site.members_enabled}}
                    {{#unless @site.members_invite_only}}
                    {{#unless @member}}
                    <form class="mm-boc-sub__form mm-bocados__form" data-members-form>
                        <label for="mm-boc-sub-email" class="mm-visually-hidden">Tu email</label>
                        <div class="mm-bocados__field">
                            <input
                                id="mm-boc-sub-email"
                                class="mm-bocados__input"
                                type="email"
                                name="email"
                                data-members-email
                                placeholder="nombre@email.com"
                                required="true"
                            >
                            <button class="mm-bocados__btn" type="submit" aria-label="Suscribirse a Bocados">
                                Quiero recibirlos
                            </button>
                        </div>
                        <p class="mm-boc-sub__note">Gratis, directo a tu correo.</p>
                        <p class="error-message"></p>
                        <p class="success-message"></p>
                    </form>
                    {{/unless}}
                    {{/unless}}
                    {{/if}}
                </div>

                {{!-- Columna derecha: muestra del contenido — último bocado (dinámico,
                     misma lógica que usaba la sección inferior) + link al archivo.
                     Imagen + "Último bocado" + título, todo clickeable. --}}
                <div class="mm-boc-sub__sample">
                    {{#get "posts" limit="1" as |latest|}}
                        {{#foreach latest}}
                            <a href="{{url}}" class="mm-boc-sub__latest">
                                {{#if feature_image}}
                                    <span class="mm-boc-sub__latest-media">
                                        <img
                                            src="{{img_url feature_image size="s"}}"
                                            srcset="{{img_url feature_image size="s"}} 1x, {{img_url feature_image size="m"}} 2x"
                                            alt="{{title}}"
                                            class="mm-boc-sub__latest-img"
                                            loading="lazy"
                                            width="320"
                                            height="200"
                                        >
                                    </span>
                                {{/if}}
                                <span class="mm-boc-sub__latest-body">
                                    <span class="mm-boc-sub__latest-eyebrow">Último bocado</span>
                                    <span class="mm-boc-sub__latest-title">{{title}}</span>
                                </span>
                            </a>
                        {{/foreach}}
                    {{/get}}

                    <a href="/bocados/" class="mm-boc-sub__archive-link">Ver todos los bocados <span aria-hidden="true">→</span></a>
                </div>

            </div>
        </div>
    </section>

    {{!-- 6. La Bestia --}}
    <section class="mm-bestia" aria-labelledby="bestia-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-bestia__grid">
                <div class="mm-bestia__visual">
                    <img
                        src="{{asset "images/cover-es-720.webp"}}"
                        srcset="{{asset "images/cover-es-720.webp"}} 720w, {{asset "images/cover-es-1080.webp"}} 1080w"
                        sizes="240px"
                        alt="La Bestia, libro de Rodri Ponce de León"
                        class="mm-bestia__book"
                        loading="lazy"
                        width="720"
                        height="1152"
                    >
                </div>
                <div class="mm-bestia__text">
                    <h2 class="mm-v2-title" id="bestia-title">
                        <span class="mm-accent">Mi libro.</span>
                    </h2>
                    <div class="mm-prose">
                        <p>Todos tenemos una Bestia.</p>
                        <p>Esa parte de nosotros que aparece cuando algo se pone difícil y trata de convencernos de reaccionar, evitar, postergar o elegir el camino fácil.</p>
                        <p>No podemos hacerla desaparecer. Pero podemos aprender a reconocerla antes de que decida por nosotros.</p>
                    </div>
                    <div class="mm-actions mm-bestia__actions">
                        <a href="/bestia/" class="mm-btn mm-btn--ghost">Conocer el libro</a>
                        <p class="mm-bestia__rating">
                            <span class="mm-bestia__stars" aria-hidden="true">★★★★★</span>
                            <span class="mm-bestia__rating-text">5,0 en Amazon</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 7. Contacto --}}
    <section class="mm-home-contact" id="mm-home-contact" aria-labelledby="home-contact-title">
        <div class="mm-canvas">
            <div class="mm-home-contact__panel">
                <header class="mm-home-contact__header">
                    <h2 class="mm-v2-title mm-home-contact__title" id="home-contact-title">
                        ¿Tenés algo para <span class="mm-accent">masticar?</span>
                    </h2>
                    <p class="mm-home-contact__subhead">Ya sea para tu equipo o para vos, contame qué tenés en mente.</p>
                </header>

                <div class="mm-actions mm-home-contact__actions">
                    <a id="mm-home-whatsapp" class="mm-btn mm-btn--primary mm-home-whatsapp" href="https://wa.me/59898043397?text=Hola%20Rodri%2C%20estuve%20mirando%20Para%20masticar%20y%20quer%C3%ADa%20hacerte%20una%20consulta." target="_blank" rel="noopener noreferrer">
                        <span class="mm-home-whatsapp__icon" aria-hidden="true">{{> "icons/whatsapp"}}</span>
                        <span>Hablemos por WhatsApp</span>
                    </a>
                </div>

                <p class="mm-home-contact__fallback">O, si preferís, podés escribirme a <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.</p>
            </div>
        </div>
    </section>

</main>

<script>
// Record the WhatsApp contact through the existing, Ghost-injected Meta Pixel.
(function () {
    var link = document.querySelector('.mm-home-refresh #mm-home-whatsapp');
    if (!link || link.getAttribute('data-meta-contact-bound') === 'true') return;
    link.setAttribute('data-meta-contact-bound', 'true');
    link.addEventListener('click', function () {
        if (typeof window.fbq !== 'function') return;
        try {
            window.fbq('track', 'Contact');
        } catch (error) {
            // WhatsApp navigation remains available if the Pixel fails.
        }
    }, true);
})();
</script>

{{#contentFor "body_class"}}homepage-mm-v2{{/contentFor}}
