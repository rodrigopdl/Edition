{{!-- Only /sesiones uses these metadata overrides; other pages keep ghost_head. --}}
<meta name="description" content="Masticadas individuales con Rodri: encuentros uno a uno de 60 minutos, remotos, para explorar algo que te importa con historias e ideas preparadas para la conversación.">
<link rel="canonical" href="{{@site.url}}/sesiones/">
{{#if @site.icon}}<link rel="icon" href="{{@site.icon}}">{{/if}}
{{#is "preview"}}<meta name="robots" content="noindex,nofollow">{{/is}}
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta property="og:site_name" content="{{@site.title}}">
<meta property="og:type" content="website">
<meta property="og:title" content="Masticadas individuales — {{@site.title}}">
<meta property="og:description" content="Un encuentro para pensar a fondo sobre algo que te importa, con historias e ideas que enriquecen la conversación.">
<meta property="og:url" content="{{@site.url}}/sesiones/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Masticadas individuales — {{@site.title}}">
<meta name="twitter:description" content="Un encuentro para pensar a fondo sobre algo que te importa, con historias e ideas que enriquecen la conversación.">
{{#if @site.cover_image}}
<meta property="og:image" content="{{@site.cover_image}}">
<meta name="twitter:image" content="{{@site.cover_image}}">
{{/if}}
