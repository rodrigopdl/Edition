            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}">
            {{else}}
                {{@site.title}}
            {{/if}}
        </a>
        <div class="mm-campaign-footer__details">
            <p class="mm-footer-year">© {{date format="YYYY"}} {{@site.title}}</p>
            {{#foreach @site.secondary_navigation}}
                {{#match label "Privacidad"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Política de privacidad"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Aviso legal"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Términos y condiciones"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Cookies"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Privacy Policy"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Terms of Service"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Privacy"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{else match label "Terms"}}
                    <a class="mm-campaign-footer__legal" href="{{url}}">{{label}}</a>
                {{/match}}
            {{/foreach}}
        </div>
    </div>
</footer>
{{/contentFor}}
