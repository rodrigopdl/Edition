{{!< default}}
{{!--
Template Name: Masticadas
--}}

<main class="homepage-main mm-v2 mm-mast">

    {{!-- 1. Hero ----------------------------------------------------------- --}}
    <section class="mm-v2-hero mm-mast-hero" aria-labelledby="mast-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <p class="mm-eyebrow">Masticadas</p>

                <h1 class="mm-hero__title" id="mast-title">
                    Una conversación única <span class="mm-accent">para tu equipo.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Las masticadas son experiencias de conversación para equipos y organizaciones que necesitan frenar, pensar y abrir conversaciones que vienen necesitando tener.</p>
                    <p>No son charlas tradicionales ni capacitaciones. Son espacios diseñados para mirar lo que está pasando, poner en palabras lo que suele quedar enterrado y encontrar más claridad juntos.</p>
                </div>

                <div class="mm-actions mm-actions--center">
                    <a href="#mm-mast-form" class="mm-btn mm-btn--primary">Solicitar una masticada</a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. No es una charla. Es una ronda. -------------------------------- --}}
    <section class="mm-mast-what" aria-labelledby="mast-what-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-mast-what__inner">
                <header class="mm-mast-what__header">
                    <p class="mm-eyebrow">Qué es</p>
                    <h2 class="mm-v2-title" id="mast-what-title">
                        Una ronda para <span class="mm-accent">masticar lo que está pasando.</span>
                    </h2>
                </header>

                <div class="mm-prose mm-mast-what__prose">
                    <p>Nos sentamos en ronda, con música tenue de fondo, y masticamos juntos una pregunta, una tensión o un tema que el equipo necesita mirar con más calma.</p>
                    <p>No es una charla tradicional ni una capacitación. No hay diapositivas, no hay dinámicas forzadas y no hay recetas genéricas. Hay una conversación guiada, cuidada y suficientemente profunda como para que aparezcan cosas que normalmente no aparecen en la urgencia del día a día.</p>
                    <p>En un equipo, <em>La Bestia</em> también aparece: cuando postergamos conversaciones, evitamos feedback, callamos ideas o reaccionamos desde el miedo. Una masticada no busca enseñar liderazgo desde un manual. Busca abrir un espacio para mirarse con más honestidad en medio de lo que se vive con otros.</p>
                </div>

                <dl class="mm-mast-what__meta">
                    <div class="mm-mast-what__meta-item">
                        <dt>Duración</dt>
                        <dd>90 a 120 minutos</dd>
                    </div>
                    <div class="mm-mast-what__meta-item">
                        <dt>Formato</dt>
                        <dd>Ronda, música ambiente, conversación guiada</dd>
                    </div>
                    <div class="mm-mast-what__meta-item">
                        <dt>Grupos</dt>
                        <dd>Equipos o grupos reducidos</dd>
                    </div>
                    <div class="mm-mast-what__meta-item">
                        <dt>Temática</dt>
                        <dd>A medida del momento del equipo</dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>

    {{!-- 3. Masticadas que ya pasaron -------------------------------------- --}}
    <section class="mm-mast-real" aria-labelledby="mast-real-title">
        <div class="mm-canvas">
            <header class="mm-mast-real__header">
                <p class="mm-eyebrow">Experiencias</p>
                <h2 class="mm-v2-title" id="mast-real-title">
                    Masticadas que ya <span class="mm-accent">pasaron.</span>
                </h2>
            </header>

            <div class="mm-mast-real__grid">
                <figure class="mm-mast-real__item">
                    <div class="mm-mast-real__frame">
                        <img
                            src="{{asset "images/masticada-fernandez.jpg"}}"
                            alt="Masticada en Fernández Secco"
                            class="mm-mast-real__img"
                            loading="lazy"
                        >
                    </div>
                    <figcaption class="mm-mast-real__caption">Fernández Secco</figcaption>
                </figure>

                <figure class="mm-mast-real__item">
                    <div class="mm-mast-real__frame">
                        <img
                            src="{{asset "images/masticada-wyeworks.jpg"}}"
                            alt="Masticada en WyeWorks"
                            class="mm-mast-real__img"
                            loading="lazy"
                        >
                    </div>
                    <figcaption class="mm-mast-real__caption">WyeWorks</figcaption>
                </figure>

                <figure class="mm-mast-real__item">
                    <div class="mm-mast-real__frame">
                        <img
                            src="{{asset "images/masticada-selecta.png"}}"
                            alt="Masticada en Selecta"
                            class="mm-mast-real__img"
                            loading="lazy"
                        >
                    </div>
                    <figcaption class="mm-mast-real__caption">Selecta</figcaption>
                </figure>
            </div>
        </div>
    </section>

    {{!-- 4. Voces ----------------------------------------------------------- --}}
    <section class="mm-mast-voices" aria-labelledby="mast-voices-title">
        <div class="mm-canvas">
            <p class="mm-eyebrow mm-eyebrow--muted" id="mast-voices-title">Devoluciones</p>

            <figure class="mm-mast-voices__feature">
                <blockquote class="mm-mast-voices__quote">
                    <span class="mm-mast-voices__mark" aria-hidden="true">“</span>Queda esa sensación de que hay mucho más para hablar, como que queda corto el espacio pero en el buen sentido.
                </blockquote>
                <figcaption class="mm-mast-voices__cite">
                    <span class="mm-mast-voices__name">Federico</span>
                </figcaption>
            </figure>

            <div class="mm-mast-voices__grid">
                <figure class="mm-mast-voices__item">
                    <blockquote>Abriste frentes en los cuales quiero trabajar y conseguir una mejor versión de mí.</blockquote>
                    <figcaption>Diego</figcaption>
                </figure>

                <figure class="mm-mast-voices__item">
                    <blockquote>Se generó un ambiente muy lindo. Comencé a leer el libro y me suscribí al blog. Tu trabajo puede ser un gran aporte.</blockquote>
                    <figcaption>Carolina</figcaption>
                </figure>

                <figure class="mm-mast-voices__item">
                    <blockquote>Muy buena participación y se mantuvo un ambiente de respeto, compañerismo y crecimiento.</blockquote>
                    <figcaption>Joaquín</figcaption>
                </figure>
            </div>
        </div>
    </section>

    {{!-- 5. Formulario final ------------------------------------------------ --}}
    <section class="mm-mast-form-section" id="mm-mast-form" aria-labelledby="mast-form-title">
        <div class="mm-canvas">
            <div class="mm-mast-form__panel">
                <header class="mm-mast-form__header">
                    <p class="mm-eyebrow">Solicitar</p>
                    <h2 class="mm-v2-title" id="mast-form-title">
                        Empecemos por <span class="mm-accent">una conversación.</span>
                    </h2>
                    <p class="mm-mast-form__lede">
                        Si te gustaría llevar una masticada a tu equipo, escribime y contame
                        brevemente qué está pasando. No hace falta que tengas el tema cerrado.
                        Podemos empezar por entender qué conversación tendría sentido abrir.
                    </p>
                    <p class="mm-mast-form__byline">
                        Facilitadas por Rodri, creador de Para Masticar y autor de <em>La Bestia</em>.
                    </p>
                </header>

                <form
                    id="mm-mast-formspree"
                    class="mm-mast-form"
                    action="https://formspree.io/f/maqpeljq"
                    method="POST"
                >
                    <input type="hidden" name="_subject" value="Masticada — solicitud desde /masticadas">
                    <input type="hidden" name="origen" value="masticadas">

                    <div class="mm-mast-form__row mm-mast-form__row--two">
                        <div class="mm-mast-field">
                            <label class="mm-mast-field__label" for="mm-mast-name">
                                Nombre
                            </label>
                            <input
                                id="mm-mast-name"
                                name="nombre"
                                type="text"
                                autocomplete="name"
                                required
                                class="mm-mast-field__input"
                            >
                        </div>

                        <div class="mm-mast-field">
                            <label class="mm-mast-field__label" for="mm-mast-email">
                                Email
                            </label>
                            <input
                                id="mm-mast-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="mm-mast-field__input"
                            >
                        </div>
                    </div>

                    <div class="mm-mast-form__row">
                        <div class="mm-mast-field">
                            <label class="mm-mast-field__label" for="mm-mast-org">
                                Organización o equipo
                            </label>
                            <input
                                id="mm-mast-org"
                                name="organizacion"
                                type="text"
                                autocomplete="organization"
                                required
                                class="mm-mast-field__input"
                            >
                        </div>
                    </div>

                    <div class="mm-mast-form__row">
                        <div class="mm-mast-field">
                            <label class="mm-mast-field__label" for="mm-mast-message">
                                Qué te gustaría trabajar o qué conversación sentís que hace falta abrir
                            </label>
                            <textarea
                                id="mm-mast-message"
                                name="mensaje"
                                rows="6"
                                required
                                class="mm-mast-field__textarea"
                            ></textarea>
                        </div>
                    </div>

                    {{!-- Honeypot --}}
                    <div class="mm-mast-form__honeypot" aria-hidden="true">
                        <label for="mm-mast-website">No completar este campo</label>
                        <input id="mm-mast-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="mm-actions">
                        <button type="submit" class="mm-btn mm-btn--primary mm-btn--lg">
                            Solicitar una masticada
                        </button>
                    </div>

                    <p id="mm-mast-form-status" class="mm-mast-form__status" role="status" aria-live="polite"></p>

                    <p class="mm-mast-form__fallback">
                        También podés escribirme a
                        <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                    </p>
                </form>
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2 page-masticadas{{/contentFor}}

{{!-- AJAX submit: same pattern as /conversar --}}
<script>
(function () {
    var form = document.getElementById('mm-mast-formspree');
    if (!form) return;
    var status = document.getElementById('mm-mast-form-status');
    var submitBtn = form.querySelector('button[type="submit"]');

    function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg;
        status.dataset.state = state || '';
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.dataset.label = submitBtn.textContent;
            submitBtn.textContent = 'Enviando…';
        }
        setStatus('', 'loading');

        var data = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (res.ok) {
                form.reset();
                setStatus('Gracias. Ya recibí tu mensaje. Te voy a leer con atención y te respondo pronto.', 'success');
            } else {
                return res.json().then(function (body) {
                    var msg = (body && body.errors && body.errors[0] && body.errors[0].message)
                        || 'Algo no funcionó. Probá de nuevo en un momento.';
                    setStatus(msg, 'error');
                }).catch(function () {
                    setStatus('Algo no funcionó. Probá de nuevo en un momento.', 'error');
                });
            }
        }).catch(function () {
            setStatus('No pudimos enviar el mensaje. Revisá tu conexión y probá de nuevo.', 'error');
        }).finally(function () {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.label || 'Solicitar una masticada';
            }
        });
    });
})();
</script>
