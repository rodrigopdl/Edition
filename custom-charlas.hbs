{{!< default}}
{{!--
Template Name: Charlas
--}}

<main class="homepage-main mm-v2 mm-ch-v2">

    {{!-- 1. Hero --}}
    <section class="mm-v2-hero mm-ch-v2-hero" aria-labelledby="ch-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <p class="mm-eyebrow mm-ch-v2-hero__eyebrow">Un encuentro para equipos</p>
                <h1 class="mm-hero__title mm-ch-v2-hero__title" id="ch-title">
                    <span class="mm-accent">La masticada.</span>
                </h1>
                <div class="mm-hero__lede mm-ch-v2-hero__lede">
                    <p>Historias, ideas y conversaciones para reconocer cómo influimos en los demás y pensar qué queremos aportar al equipo.</p>
                </div>
                <!--p class="mm-ch-v2-hero__facts">2 horas <span aria-hidden="true">·</span> Experiencia presencial</p-->
                <div class="mm-actions mm-actions--center">
                    <a href="#mm-ch-cta" class="mm-btn mm-btn--primary mm-btn--lg js-smooth-scroll mm-ch-v2-mast-cta">
                        Quiero organizar una masticada
                    </a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. El porqué de una masticada — antes de contar cómo se desarrolla. --}}
    <section class="mm-ch-v2-why" id="mm-ch-what" aria-labelledby="ch-why-title">
        <div class="mm-canvas mm-canvas--narrow">
            <h2 class="mm-v2-title" id="ch-why-title">
                Un equipo se construye <span class="mm-accent">entre todos.</span>
            </h2>
            <div class="mm-prose">
                <p>Cada persona influye en los demás. Con lo que dice, con lo que hace, con cómo reacciona ante las dificultades y con la energía que lleva al trabajo cada día.</p>
                <p>Una masticada es una invitación a detenernos y pensar en esa influencia. A reconocer que todos tenemos algo que aportar al equipo que construimos juntos.</p>
            </div>
        </div>
    </section>

    {{!-- 3. Prueba social de la masticada (Joaquín): foto grupal + testimonio,
         antes de narrar la experiencia. --}}
    <section class="mm-ch-v2-real" aria-labelledby="ch-real-title">
        <div class="mm-canvas">
            <div class="mm-ch-v2-exp mm-ch-v2-exp--lead">
                <h2 class="mm-ch-v2-exp__heading" id="ch-real-title">
                    <span class="mm-ch-v2-exp__heading-intro">Una masticada en</span>
                    Fernández Secco &amp; Asociados
                </h2>
                <figure class="mm-ch-v2-exp__photo">
                    <div class="mm-ch-v2-real__frame">
                        <img
                            src="{{asset "images/masticada-fernandez.jpg"}}"
                            alt="Masticada en Fernández Secco"
                            class="mm-ch-v2-real__img"
                            loading="lazy"
                            width="1728"
                            height="1139"
                        >
                    </div>
                </figure>
                <figure class="mm-ch-v2-testimonial">
                    <blockquote class="mm-testimonial__quote mm-ch-v2-testimonial__quote">
                        <span class="mm-testimonial__mark" aria-hidden="true">“</span>La masticada con Rodri fue una experiencia transformadora para nuestro equipo. Se generó un espacio para compartir experiencias muy enriquecedoras sobre La Bestia que permitieron potenciar la forma en la que nos complementamos y establecer un marco de referencia común para el futuro. El equipo salió súper motivado y más conectado de la masticada.
                    </blockquote>
                    <figcaption class="mm-testimonial__cite mm-ch-v2-testimonial__author">
                        <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/joaco.jpeg"}}"
                            alt="Joaquín Fernández"
                            class="mm-testimonial__avatar-img"
                            width="48"
                            height="48"
                            loading="lazy"
                        >
                        </div>
                        <div class="mm-testimonial__person">
                            <span class="mm-testimonial__name">Joaquín Fernández</span>
                            <span class="mm-testimonial__role">Socio, Fernández Secco &amp; Asociados</span>
                        </div>
                    </figcaption>
                </figure>

                <div class="mm-actions mm-ch-v2-exp__cta">
                    <a href="#mm-ch-cta" class="mm-ch-v2-exp__link js-smooth-scroll mm-ch-v2-mast-cta" data-tipo="masticada">
                        Quiero organizar una masticada <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 4. Cómo se desarrolla una masticada — narración condensada en tres
         momentos (ambientación, historias, conversación), con las fotos reales. --}}
    <section class="mm-ch-v2-what" aria-labelledby="ch-what-title">
        <div class="mm-canvas mm-canvas--narrow">
            <h2 class="mm-v2-title" id="ch-what-title">
                Nos sentamos en <span class="mm-accent">una gran ronda.</span>
            </h2>
            <div class="mm-prose">
                <p>Pongo un parlante en el centro, suena un jazz tenue de fondo. No hay pantallas ni diapositivas, y si hay luces bajas, mejor. La ambientación es parte del secreto.</p>
                <p class="mm-ch-v2-beat">Primero cuento historias.</p>
                <p>De lo cotidiano, del liderazgo, de clientes difíciles, del deporte. Historias que giran alrededor de dos fuerzas que conviven dentro nuestro: La Bestia, esa parte que aparece cuando algo se pone difícil y nos empuja a reaccionar, evitar o elegir el camino fácil; y el fuego, eso que arde cuando estamos entusiasmados y nos ayuda en los momentos difíciles.</p>
                <p>No doy fórmulas. Prefiero masticar en voz alta lo que me dejaron esas historias y dejar ideas dando vueltas para que cada uno descubra qué hacer con ellas.</p>
            </div>
        </div>

        {{!-- Imagen de una masticada (collage Ruby Meetup), entre el momento de
             las historias y el de la conversación. Mismo ancho que el texto. --}}
        <div class="mm-canvas mm-canvas--narrow mm-ch-v2-ruby">
            <figure class="mm-ch-v2-ruby__figure">
                <img
                    src="{{asset "images/masticada-ruby.png"}}"
                    alt="Escenas de una masticada: personas sentadas conversando"
                    class="mm-ch-v2-ruby__img"
                    loading="lazy"
                    width="1600"
                    height="1113"
                >
                <figcaption class="mm-ch-v2-what__caption">Una masticada en la Ruby MVD Meetup</figcaption>
            </figure>
        </div>

        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-prose">
                <p class="mm-ch-v2-beat">Después, el protagonismo pasa al equipo.</p>
                <p>Facilito la conversación con preguntas que ayuden a las personas a escucharse. Nadie está obligado a hablar: solo habla el que le nace. Hasta que alguien da el primer paso, comparte algo que le resonó, y eso abre la puerta para que aparezcan otras voces.</p>
                <p>Me gusta cuando la conversación termina y queda la sensación de que todavía hay mucho para hablar. De que algo nos hizo mirar las cosas de otra manera o nos dejó pensando en algo que nunca nos habíamos preguntado. Como si la masticada terminara, pero algunas conversaciones recién estuvieran empezando.</p>
            </div>
        </div>

        {{!-- Segunda foto de masticada (Piano Piano), tras el cierre narrativo.
             Con el marco crema de las demás fotos del sitio. --}}
        <div class="mm-canvas mm-canvas--narrow mm-ch-v2-ruby mm-ch-v2-ruby--close mm-ch-v2-ruby--framed">
            <h2 class="mm-ch-v2-exp__heading mm-ch-v2-exp__heading--photo">
                <span class="mm-ch-v2-exp__heading-intro">Una masticada en</span>
                Piano Piano Producciones
            </h2>
            <figure class="mm-ch-v2-ruby__figure">
                <div class="mm-ch-v2-real__frame">
                    <img
                        src="{{asset "images/pianopiano.jpg"}}"
                        alt="Masticada con el equipo de Piano Piano Producciones"
                        class="mm-ch-v2-ruby__img"
                        loading="lazy"
                        width="1312"
                        height="644"
                    >
                </div>
            </figure>
        </div>
    </section>

    {{!-- Presentación personal, entre la experiencia y la propuesta. --}}
    <section class="mm-intro mm-ch-v2-intro" aria-labelledby="ch-intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri Ponce de León"
                            class="mm-intro__img"
                            width="800"
                            height="1200"
                            loading="lazy"
                        >
                    </div>
                </figure>
                <div class="mm-intro__text">
                    <h2 class="mm-v2-title" id="ch-intro-title">Hola, <span class="mm-accent">soy Rodri.</span></h2>
                    <div class="mm-prose">
                        <p>Durante más de una década trabajé en WyeWorks, una empresa de tecnología uruguaya. Empecé como desarrollador de software, después pasé a formar parte del equipo de managers y terminé como acompañante estratégico del CEO.</p>
                        <p>En ese camino entendí que muchos de los problemas más difíciles no eran técnicos. Eran humanos. Y muchas veces empezaban por uno mismo.</p>
                        <p>Eso me llevó a leer, escribir y prestar más atención a cómo pensamos, qué nos frena y cómo influimos en los demás. Con el tiempo fui construyendo mi propia forma de mirar el liderazgo. Así nació <em>Para masticar</em>: un proyecto que empezó con los bocados que escribo cada semana y fue creciendo hasta dar lugar a mi libro <em>La Bestia</em> y a encuentros como las masticadas.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- 5. Bloque crema comercial: "Organizá una masticada". Transición natural
         del relato a la propuesta concreta. Conserva id=mm-ch-mast. --}}
    <section class="mm-ch-v2-plus" id="mm-ch-mast" aria-labelledby="ch-mast-name">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-ch-v2-formats__panel mm-ch-v2-formats__panel--hero">
                <h3 class="mm-ch-v2-formats__name mm-ch-v2-formats__name--hero" id="ch-mast-name">Organizá una masticada.</h3>
                <p class="mm-ch-v2-formats__lead">Una conversación distinta para que tu equipo comparta, se escuche y se conozca más allá del día a día.</p>
                <!--p class="mm-ch-v2-formats__note-hero">2 horas <span aria-hidden="true">·</span> Experiencia presencial</p-->
                <div class="mm-actions mm-ch-v2-formats__actions">
                    <a href="#mm-ch-cta"
                       class="mm-btn mm-btn--primary mm-btn--lg js-smooth-scroll mm-ch-v2-mast-cta"
                       data-tipo="masticada">
                        Consultar por una masticada
                    </a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 5. Charlas: otro formato disponible. La tarjeta crema mantiene
         a la Masticada como propuesta protagonista. --}}
    <section class="mm-ch-v2-plus mm-ch-v2-plus--alt" aria-labelledby="ch-alt-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-ch-v2-alt">
                <p class="mm-ch-v2-alt__q" id="ch-alt-title">También podés invitarme a dar una charla.</p>
                <div class="mm-ch-v2-alt__body">
                    <div class="mm-ch-v2-alt__text">
                        <div class="mm-ch-v2-alt__head">
                            <h4 class="mm-ch-v2-alt__name">Una charla para dejar pensando</h4>
                            <p class="mm-ch-v2-alt__duration">30–45 minutos</p>
                        </div>
                        <p class="mm-ch-v2-alt__desc">Historias e ideas sobre liderazgo para abrir conversaciones que sigan después.</p>
                        <a href="#mm-ch-cta"
                           class="mm-ch-v2-alt__link js-smooth-scroll mm-ch-v2-charla-cta"
                           data-tipo="charla">
                            Consultar por una charla <span aria-hidden="true">→</span>
                        </a>
                    </div>
                    <figure class="mm-ch-v2-alt__photo">
                        <div class="mm-ch-v2-real__frame">
                            <img
                                src="{{asset "images/talks-lameetup-2-1200.webp"}}"
                                srcset="{{asset "images/talks-lameetup-2-720.webp"}} 720w, {{asset "images/talks-lameetup-2-1200.webp"}} 1200w"
                                sizes="(max-width: 640px) calc(100vw - 44px), 360px"
                                alt="Rodri dando una charla frente a una audiencia — Conferencia La Meetup II en Sinergia Faro"
                                class="mm-ch-v2-alt__img"
                                loading="lazy"
                                width="1200"
                                height="800"
                            >
                        </div>
                    </figure>
                </div>

                {{!-- Prueba social de la charla: testimonio de Lucía. Sin foto
                     (el bloque Charla de arriba ya muestra la imagen del formato),
                     para no repetir dos fotos de charla seguidas. --}}
                <figure class="mm-ch-v2-backing mm-ch-v2-backing--alt">
                    <blockquote class="mm-testimonial__quote mm-ch-v2-backing__quote">
                        <span class="mm-testimonial__mark" aria-hidden="true">“</span>Tu presentación me inspiró muchísimo. Quiero destacar la tranquilidad que transmitiste, y el sentimiento de 'es re por acá' que me dejaste.
                    </blockquote>
                    <figcaption class="mm-testimonial__cite mm-ch-v2-backing__author">
                        <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/lucia.jpeg"}}"
                            alt="Lucía Del Arco"
                            class="mm-testimonial__avatar-img"
                            width="48"
                            height="48"
                            loading="lazy"
                        >
                        </div>
                        <div class="mm-testimonial__person">
                            <span class="mm-testimonial__name">Lucía Del Arco</span>
                            <span class="mm-testimonial__role">Delivery Manager</span>
                        </div>
                    </figcaption>
                </figure>
            </div>
        </div>
    </section>

    {{!-- 5. CTA final — formulario embebido en la página (mismo Formspree que el
         resto del sitio), adaptado a charlas. No lleva a la home. --}}
    <section class="mm-ch-v2-cta mm-ch-v2-form" id="mm-ch-cta" aria-labelledby="ch-cta-title">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-ch-v2-cta__inner">
                <h2 class="mm-v2-title" id="ch-cta-title">
                    ¿Tenés algo <span class="mm-accent">en mente?</span>
                </h2>
                <p class="mm-ch-v2-cta__lede">
                    Ya sea una masticada o una charla, contame un poco sobre el equipo, encuentro o evento que estás organizando.
                </p>

                <div class="mm-ch-v2-form__form" id="mm-ch-form">
                    {{> "contact-form"
                        show_selector=false
                        charla_choice=true
                        tipo_predefinido="charla"
                        origen="charlas"
                        subject="Contacto — desde /masticadas/"
                        message_label="Contame un poco"
                        message_placeholder="Contame un poco sobre tu equipo, cuántas personas son y qué tenés en mente."}}
                </div>

                <p class="mm-ch-v2-cta__fallback">
                    También podés escribirme a
                    <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                </p>
            </div>
        </div>
    </section>

</main>

{{!-- CTA final: rename the shared partial's submit to "Enviar" for this page,
     y preseleccionar "Una masticada" cuando se llega desde el CTA del bloque
     protagonista de Masticada. --}}
<script>
(function () {
    'use strict';
    var form = document.getElementById('mm-ch-form');
    if (!form) return;

    var submit = form.querySelector('button[type="submit"]');
    if (submit) submit.textContent = 'Enviar';

    {{!-- Los CTA de cada formato preseleccionan su opción en el selector. --}}
    function preselect(val) {
        var radios = form.querySelectorAll('input[name="tipo_consulta"]');
        for (var i = 0; i < radios.length; i++) {
            if (radios[i].value === val) { radios[i].checked = true; break; }
        }
    }

    {{!-- Hay varios CTA de masticada (hero + bloque crema); todos preseleccionan. --}}
    var mastCtas = document.querySelectorAll('.mm-ch-v2-mast-cta');
    for (var m = 0; m < mastCtas.length; m++) {
        mastCtas[m].addEventListener('click', function () { preselect('Una masticada'); });
    }

    var charlaCta = document.querySelector('.mm-ch-v2-charla-cta');
    if (charlaCta) charlaCta.addEventListener('click', function () { preselect('Una charla'); });
})();
</script>

