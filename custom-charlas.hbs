{{!< default}}
{{#contentFor "page_styles"}}
<link rel="stylesheet" href="{{asset "css/site/masticadas-campana.css"}}">
{{/contentFor}}
{{!--
Template Name: Charlas
--}}

<main class="homepage-main mm-v2 mm-ch-v2">

    {{!-- 1. Hero --}}
    <section class="mm-v2-hero mm-ch-v2-hero" aria-labelledby="ch-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <p class="mm-eyebrow mm-campaign-eyebrow">La masticada</p>
                <h1 class="mm-hero__title mm-ch-v2-hero__title" id="ch-title">
                    Una conversación que <span class="mm-accent">acerca a tu equipo.</span>
                </h1>
                <div class="mm-hero__lede mm-ch-v2-hero__lede">
                    <p>90 minutos reflexionando juntos, a partir de historias que dejan mucho para masticar.</p>
                </div>
                <div class="mm-actions mm-actions--center">
                    <a href="https://wa.me/59898043397?text=Hola%20Rodri%2C%20vi%20la%20propuesta%20de%20las%20masticadas%20y%20me%20interes%C3%B3%20para%20mi%20equipo.%20%C2%BFPodemos%20conversar%3F" class="mm-btn mm-btn--primary mm-btn--lg mm-btn--whatsapp" target="_blank" rel="noopener noreferrer">
                        <span class="mm-btn__whatsapp-icon" aria-hidden="true">{{> "icons/whatsapp"}}</span>
                        <span class="mm-btn__label">Quiero una masticada</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="mm-ch-v2-real" aria-label="Experiencia de un equipo">
        <div class="mm-canvas">
            <div class="mm-ch-v2-exp mm-ch-v2-exp--lead">
                <figure class="mm-ch-v2-exp__photo">
                    <div class="mm-ch-v2-real__frame">
                        <img
                            src="{{asset "images/masticada-fernandez-zoom2.jpg"}}"
                            alt="Masticada en Fernández Secco"
                            class="mm-ch-v2-real__img"
                            loading="eager" fetchpriority="high"
                            width="1708"
                            height="717"
                        >
                    </div>
                </figure>
                <figure class="mm-ch-v2-testimonial">
                    <blockquote class="mm-testimonial__quote mm-ch-v2-testimonial__quote" id="joaquin-quote">
                        <span class="mm-testimonial__mark" aria-hidden="true">“</span><span id="joaquin-excerpt" hidden>El equipo salió súper motivado y más conectado de la masticada.</span><span id="joaquin-full">La masticada con Rodri fue una experiencia transformadora para nuestro equipo. Se generó un espacio para compartir experiencias muy enriquecedoras sobre La Bestia que permitieron potenciar la forma en la que nos complementamos y establecer un marco de referencia común para el futuro. El equipo salió súper motivado y más conectado de la masticada.</span>
                    </blockquote>
                    <figcaption class="mm-testimonial__cite mm-ch-v2-testimonial__author">
                        <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/joaco.jpeg"}}"
                            alt="Joaquín Fernández"
                            class="mm-testimonial__avatar-img"
                            width="48"
                            height="48"
                            loading="lazy"
                        >
                        </div>
                        <div class="mm-testimonial__person">
                            <span class="mm-testimonial__name">Joaquín Fernández</span>
                            <span class="mm-testimonial__role">Socio, Fernández Secco &amp; Asociados</span>
                        </div>
                    </figcaption>
                    <button class="mm-testimonial-toggle" type="button" aria-expanded="false" aria-controls="joaquin-quote" hidden>Leer testimonio completo</button>
                </figure>

            </div>
        </div>
    </section>

    <section class="mm-ch-v2-what" aria-labelledby="ch-what-title">
        <div class="mm-canvas mm-canvas--narrow mm-campaign-explanation">
            <h2 class="mm-v2-title" id="ch-what-title">
                ¿Cómo es una masticada?
            </h2>
            <div class="mm-prose">
                <p>Voy a donde se reúne tu equipo y nos sentamos en ronda. Pongo un poco de jazz de fondo y empiezo compartiendo historias de mi libro <em>La Bestia</em>.</p>
                <p>Historias que invitan a reflexionar sobre lo que nos frena, lo que nos entusiasma y cómo ambas cosas influyen en nuestra manera de relacionarnos.</p>
                <p>De a poco, se abre una conversación entre todos. Voy haciendo preguntas, compartiendo nuevas historias y acompañando lo que va surgiendo.</p>
                <p class="mm-campaign-benefit">Una oportunidad para conocernos mejor a nosotros mismos y descubrir otras facetas de las personas con las que trabajamos todos los días.</p>
            </div>
        </div>

        {{!-- Dos contextos reales de una masticada, sin recortar las imágenes. --}}
        <div class="mm-canvas mm-canvas--wide mm-ch-v2-ruby mm-campaign-scenes">
            <figure class="mm-ch-v2-ruby__figure">
                <div class="mm-ch-v2-real__frame">
                    <img
                        src="{{asset "images/masticada-ruby.png"}}"
                        alt="Escenas de una masticada: personas sentadas conversando"
                        class="mm-ch-v2-ruby__img"
                        loading="lazy"
                        width="1600"
                        height="1113"
                    >
                </div>
                <figcaption class="mm-ch-v2-what__caption">Una masticada en la Ruby Meetup</figcaption>
            </figure>
            <figure class="mm-ch-v2-ruby__figure">
                <div class="mm-ch-v2-real__frame">
                    <img
                        src="{{asset "images/masticada-wyeworks.jpg"}}"
                        alt="Participantes de una masticada en WyeWorks reunidos alrededor de una mesa"
                        class="mm-ch-v2-ruby__img"
                        loading="lazy"
                        width="4032"
                        height="3024"
                    >
                </div>
                <figcaption class="mm-ch-v2-what__caption">Una masticada en WyeWorks</figcaption>
            </figure>
        </div>

        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-prose">
                <p>La experiencia dura aproximadamente <strong>90 minutos</strong> y funciona tanto con grupos pequeños como con grupos más numerosos.</p>
            </div>
            <a class="mm-campaign-contact" href="https://wa.me/59898043397?text=Hola%20Rodri%2C%20vi%20la%20propuesta%20de%20las%20masticadas%20y%20me%20interes%C3%B3%20para%20mi%20equipo.%20%C2%BFPodemos%20conversar%3F" target="_blank" rel="noopener noreferrer">
                <span class="mm-btn__whatsapp-icon" aria-hidden="true">{{> "icons/whatsapp"}}</span>
                <span>Quiero llevar una masticada a mi equipo</span>
            </a>
        </div>

        {{!-- Segunda foto de masticada (Piano Piano), tras el cierre narrativo.
             Con el marco crema de las demás fotos del sitio. --}}
        <div class="mm-canvas mm-canvas--narrow mm-ch-v2-ruby mm-ch-v2-ruby--close mm-ch-v2-ruby--framed">
            <figure class="mm-ch-v2-ruby__figure">
                <div class="mm-ch-v2-real__frame">
                    <img
                        src="{{asset "images/pianopiano.jpg"}}"
                        alt="Masticada con el equipo de Piano Piano Producciones"
                        class="mm-ch-v2-ruby__img"
                        loading="lazy"
                        width="1312"
                        height="644"
                    >
                </div>
            </figure>
            <figure class="mm-ch-v2-testimonial">
                <blockquote class="mm-testimonial__quote mm-ch-v2-testimonial__quote">
                    <span class="mm-testimonial__mark" aria-hidden="true">“</span>La masticada fue un encuentro muy lindo para Piano Piano. Pudimos compartir experiencias, escuchar distintas miradas y tener conversaciones muy enriquecedoras entre compañeros. Sentimos que nos aportó mucho como equipo.
                </blockquote>
                <figcaption class="mm-testimonial__cite mm-ch-v2-testimonial__author">
                    <div class="mm-testimonial__avatar">
                        <img
                            src="{{asset "images/fernando.jpeg"}}"
                            alt="Fernando Mino"
                            class="mm-testimonial__avatar-img"
                            width="48"
                            height="48"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-testimonial__person">
                        <span class="mm-testimonial__name">Fernando Mino</span>
                        <span class="mm-testimonial__role">Director, Piano Piano Producciones</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- Presentación personal, entre la experiencia y la propuesta. --}}
    <section class="mm-intro mm-ch-v2-intro" aria-labelledby="ch-intro-title">
        <div class="mm-canvas">
            <div class="mm-intro__grid">
                <figure class="mm-intro__figure">
                    <div class="mm-intro__frame">
                        <img
                            src="{{asset "images/rodri3.jpg"}}"
                            alt="Rodri Ponce de León"
                            class="mm-intro__img"
                            width="800"
                            height="1200"
                            loading="lazy"
                        >
                    </div>
                </figure>
                <div class="mm-intro__text">
                    <h2 class="mm-v2-title" id="ch-intro-title">Hola, <span class="mm-accent">soy Rodri.</span></h2>
                    <div class="mm-prose">
                        <p>Durante más de diez años trabajé en WyeWorks, una consultora de software uruguaya. Empecé como desarrollador, después lideré equipos y terminé trabajando codo a codo con el CEO, ayudándolo a pensar los desafíos de la empresa.</p>
                        <p>En ese camino descubrí que los problemas más difíciles rara vez eran técnicos. Tenían que ver con las personas, con lo que nos pasa por dentro y cómo eso influye en nuestra manera de relacionarnos.</p>
                        <p>Y fui descubriendo cuánto ayuda detenernos a reflexionar para entender mejor lo que nos pasa. Sobre todo cuando lo hacemos con otros, compartiendo lo que pensamos y escuchando otras maneras de ver las cosas.</p>
                        <p>Por eso creé <em>Para masticar</em>: para ayudar a personas y equipos a hacer de la reflexión un hábito.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{!-- Contacto de la campaña por WhatsApp. --}}
    <section class="mm-ch-v2-plus" id="mm-ch-mast" aria-labelledby="ch-mast-name">
        <div class="mm-canvas mm-canvas--narrow">
            <div class="mm-ch-v2-formats__panel mm-ch-v2-formats__panel--hero">
                <h3 class="mm-ch-v2-formats__name mm-ch-v2-formats__name--hero" id="ch-mast-name">Que tu equipo termine el año <span class="mm-accent">más conectado.</span></h3>
                <p class="mm-ch-v2-formats__lead">Escribime y coordinamos una masticada.</p>
                <div class="mm-actions mm-ch-v2-formats__actions">
                    <a href="https://wa.me/59898043397?text=Hola%20Rodri%2C%20vi%20la%20propuesta%20de%20las%20masticadas%20y%20me%20interes%C3%B3%20para%20mi%20equipo.%20%C2%BFPodemos%20conversar%3F"
                       class="mm-btn mm-btn--primary mm-btn--lg mm-btn--whatsapp"
                       target="_blank" rel="noopener noreferrer">
                        <span class="mm-btn__whatsapp-icon" aria-hidden="true">{{> "icons/whatsapp"}}</span>
                        <span class="mm-btn__label">Hablemos</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

</main>

<script>
(function () {
    var quote = document.getElementById('joaquin-quote');
    var excerpt = document.getElementById('joaquin-excerpt');
    var full = document.getElementById('joaquin-full');
    var toggle = document.querySelector('.page-masticadas-campana .mm-testimonial-toggle');
    if (!quote || !excerpt || !full || !toggle) return;

    excerpt.hidden = false;
    full.hidden = true;
    toggle.hidden = false;
    toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') !== 'true';
        excerpt.hidden = expanded;
        full.hidden = !expanded;
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.textContent = expanded ? 'Mostrar menos' : 'Leer testimonio completo';
    });
})();

</script>

{{#contentFor "body_class"}}homepage-mm-v2 page-charlas page-masticadas-campana{{/contentFor}}
