{{!< default}}
{{!--
Template Name: Archive
--}}

<main class="homepage-main mm-v2 mm-boc">

    {{!-- 1. Hero ----------------------------------------------------------- --}}
    <section class="mm-v2-hero mm-boc-hero" aria-labelledby="boc-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <h1 class="mm-hero__title" id="boc-title">
                    Bocados <span class="mm-accent">para pensar.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Textos cortos para mirar un poco más de cerca lo que nos pasa. Cada miércoles, por mail.</p>
                </div>

                {{!-- Inline subscription form inside the hero.
                     Same Ghost Members submit contract as the panel at
                     the bottom of the page (data-members-form + data-members-email).
                     Duplicated intentionally: Ghost's members portal binds on
                     page load, so both forms need to exist in the DOM.
                     IDs are namespaced with `--hero` to avoid collisions with
                     the bottom form (id="mm-boc-email"). --}}
                {{#if @site.members_enabled}}
                    {{#unless @site.members_invite_only}}
                        {{#unless @member}}
                            <form class="mm-boc-hero-subscribe" data-members-form>
                                <label for="mm-boc-hero-email" class="mm-visually-hidden">Tu email</label>
                                <div class="mm-boc-hero-subscribe__field">
                                    <input
                                        id="mm-boc-hero-email"
                                        class="mm-boc-hero-subscribe__input"
                                        type="email"
                                        name="email"
                                        data-members-email
                                        placeholder="tu@email.com"
                                        autocomplete="email"
                                        required="true"
                                    >
                                    <button class="mm-boc-hero-subscribe__btn" type="submit" aria-label="Suscribirme a Bocados">
                                        Recibir los bocados
                                    </button>
                                </div>
                                <p class="mm-boc-hero-subscribe__note">Sin spam. Cancelás cuando quieras.</p>
                                <p class="error-message"></p>
                                <p class="success-message">Listo. Ya estás adentro. Te voy a mandar el próximo bocado.</p>
                            </form>
                        {{else}}
                            <div class="mm-actions mm-actions--center">
                                <a href="#/portal/account" data-portal="account" class="mm-btn mm-btn--ghost mm-btn--lg">
                                    Ya recibís bocados
                                </a>
                            </div>
                        {{/unless}}
                    {{/unless}}
                {{/if}}
            </div>
        </div>
    </section>

    {{!-- 2. Bocado destacado (último publicado) ---------------------------- --}}
    {{#get "posts" limit="1" as |latest|}}
        {{#if latest}}
            {{#foreach latest}}
            <section class="mm-boc-featured" aria-labelledby="boc-featured-title">
                <div class="mm-canvas">
                    <article class="mm-boc-featured__inner">
                        <p class="mm-eyebrow mm-boc-featured__eyebrow">Último bocado</p>

                        <div class="mm-boc-featured__card{{#unless feature_image}} mm-boc-featured__card--no-media{{/unless}}">
                            {{#if feature_image}}
                                <a href="{{url}}" class="mm-boc-featured__media" aria-hidden="true" tabindex="-1">
                                    <img
                                        srcset="{{> "srcset"}}"
                                        sizes="(min-width: 1080px) 540px, (min-width: 640px) 50vw, 100vw"
                                        src="{{img_url feature_image size="l"}}"
                                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                        class="mm-boc-featured__img"
                                        loading="lazy"
                                    >
                                </a>
                            {{/if}}

                            <div class="mm-boc-featured__body">
                                <time class="mm-boc-featured__date" datetime="{{date format="YYYY-MM-DD"}}">
                                    {{date format="D MMM YYYY"}}
                                </time>
                                <h2 class="mm-boc-featured__title" id="boc-featured-title">
                                    <a href="{{url}}">{{title}}</a>
                                </h2>
                                {{#if custom_excerpt}}
                                    <p class="mm-boc-featured__excerpt">{{custom_excerpt}}…</p>
                                {{else}}
                                    {{#if excerpt}}
                                        <p class="mm-boc-featured__excerpt">{{excerpt words="32"}}…</p>
                                    {{/if}}
                                {{/if}}
                                <a href="{{url}}" class="mm-boc-featured__cta">
                                    Leer el bocado
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            </section>
            {{/foreach}}
        {{/if}}
    {{/get}}

    {{!-- 3. Archivo de bocados (excluye el destacado de arriba) ------------ --}}
    <section class="mm-boc-archive" id="mm-boc-archive" aria-labelledby="boc-archive-title">
        <div class="mm-canvas">
            <header class="mm-boc-archive__header">
                <h2 class="mm-v2-title" id="boc-archive-title">
                    Bocados <span class="mm-accent">anteriores.</span>
                </h2>
                <p class="mm-boc-archive__search">
                    ¿Buscás algo puntual?
                    <button type="button" class="mm-boc-search__btn search-trigger">
                        Usá el buscador
                        <span aria-hidden="true">→</span>
                    </button>
                </p>
            </header>

            <div class="mm-boc-archive__container">
                {{#get "posts" limit="18" as |initial_posts|}}
                    {{#if initial_posts}}
                        <ul class="archive-grid mm-boc-archive__list" id="archiveGrid" data-page="1" data-per-page="18">
                            {{#foreach initial_posts}}
                            <li class="archive-card mm-boc-archive__item">
                                <a href="{{url}}" class="archive-card-link mm-boc-archive__item-link">
                                    <div class="mm-boc-archive__item-meta">
                                        <time class="mm-boc-archive__item-date" datetime="{{date format="YYYY-MM-DD"}}">
                                            {{date format="D MMM YYYY"}}
                                        </time>
                                    </div>
                                    <h3 class="archive-card-title mm-boc-archive__item-title">{{title}}</h3>
                                    {{#if custom_excerpt}}
                                        <p class="mm-boc-archive__item-excerpt">{{custom_excerpt}}…</p>
                                    {{else}}
                                        {{#if excerpt}}
                                            <p class="mm-boc-archive__item-excerpt">{{excerpt words="28"}}…</p>
                                        {{/if}}
                                    {{/if}}
                                </a>
                            </li>
                            {{/foreach}}
                        </ul>

                        <div class="mm-boc-archive__load-more">
                            <button class="archive-load-more-button mm-boc-archive__load-more-btn" id="loadMoreButton" type="button">
                                <span class="load-more-text">Más bocados</span>
                                <svg class="load-more-spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" opacity="0.25"/>
                                    <path d="M12 2 A10 10 0 0 1 22 12" opacity="0.75"/>
                                </svg>
                            </button>
                        </div>
                    {{else}}
                        <p class="mm-boc-archive__empty">No se encontraron bocados.</p>
                    {{/if}}
                {{/get}}
            </div>
        </div>
    </section>

    {{!-- 3. Suscripción ----------------------------------------------------- --}}
    <section class="mm-boc-subscribe" id="mm-boc-subscribe" aria-labelledby="boc-subscribe-title">
        <div class="mm-canvas">
            <div class="mm-boc-subscribe__panel">
                <header class="mm-boc-subscribe__header">
                    <p class="mm-eyebrow">Suscribirse</p>
                    <h2 class="mm-v2-title" id="boc-subscribe-title">
                        El próximo llega <span class="mm-accent">el miércoles.</span>
                    </h2>
                    <p class="mm-boc-subscribe__lede">
                        Si querés recibirlo por mail, dejame tu correo. 
                    </p>
                </header>

                {{#if @site.members_enabled}}
                    {{#unless @site.members_invite_only}}
                        {{#unless @member}}
                            <form class="mm-boc-subscribe__form" data-members-form>
                                <label for="mm-boc-email" class="mm-visually-hidden">Tu email</label>
                                <div class="mm-boc-subscribe__field">
                                    <input
                                        id="mm-boc-email"
                                        class="mm-boc-subscribe__input"
                                        type="email"
                                        name="email"
                                        data-members-email
                                        placeholder="tu@email.com"
                                        required="true"
                                    >
                                    <button class="mm-boc-subscribe__btn" type="submit" aria-label="Suscribirme a Bocados">
                                        Recibir los bocados
                                    </button>
                                </div>
                                <p class="mm-boc-subscribe__note">
                                    Sin spam. Cancelás cuando quieras.
                                </p>
                                <p class="error-message"></p>
                                <p class="success-message">Listo. Ya estás adentro. Te voy a mandar el próximo bocado.</p>
                            </form>
                        {{else}}
                            <div class="mm-boc-subscribe__member">
                                <p>Ya estás recibiendo bocados. Gracias por leer.</p>
                                <a href="#/portal/account" data-portal="account" class="mm-btn mm-btn--ghost">Ver mi cuenta</a>
                            </div>
                        {{/unless}}
                    {{/unless}}
                {{/if}}
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}archive-page homepage-mm-v2 page-bocados{{/contentFor}}
