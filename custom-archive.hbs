{{!< default}}
{{!--
Template Name: Archive
--}}

<main class="archive-main">

    {{!-- Hero Section --}}
    <section class="archive-hero">
        <div class="gh-canvas">
            <h1 class="archive-title">Todos los <span class="accent-word">bocados</span></h1>
            <p class="archive-description">Explorá el archivo completo organizado por orden de publicación. Usá <button class="archive-search-inline search-trigger">el buscador</button> para encontrar bocados específicos por título, contenido o etiquetas.</p>
        </div>
    </section>

    {{!-- Random Post Button --}}
    <section class="archive-random-section">
        <div class="gh-canvas">
            <div class="related-random-button-wrapper">
                <button class="related-random-button" id="randomPostButton">
                    <span class="random-button-text">Bocado sorpresa</span>
                    <svg class="random-button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </section>

    {{!-- All Posts Archive Grid --}}
    <section class="archive-grid-section">
        <div class="archive-grid-container">
            {{#get "posts" limit="18" as |initial_posts|}}
                {{#if initial_posts}}
                    <div class="archive-grid" id="archiveGrid" data-page="1" data-per-page="18">
                        {{#foreach initial_posts}}
                        <article class="archive-card">
                            <a href="{{url}}" class="archive-card-link">
                                <div class="archive-card-image">
                                    <div class="archive-card-image-inner">
                                        {{#if feature_image}}
                                            <img
                                                srcset="{{img_url feature_image size="s"}} 400w,
                                                        {{img_url feature_image size="m"}} 750w"
                                                sizes="(min-width: 1200px) 360px, (min-width: 768px) 45vw, 90vw"
                                                src="{{img_url feature_image size="m"}}"
                                                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                                loading="lazy"
                                            >
                                        {{/if}}
                                    </div>
                                    <div class="archive-card-overlay">
                                        <h3 class="archive-card-title">{{title}}</h3>
                                    </div>
                                </div>
                            </a>
                        </article>
                        {{/foreach}}
                    </div>
                    
                    {{!-- Load More Button --}}
                    <div class="archive-load-more-wrapper">
                        <button class="archive-load-more-button" id="loadMoreButton">
                            <span class="load-more-text">Más bocados</span>
                            <svg class="load-more-spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" opacity="0.25"/>
                                <path d="M12 2 A10 10 0 0 1 22 12" opacity="0.75"/>
                            </svg>
                        </button>
                    </div>
                {{else}}
                    <p class="archive-empty">No se encontraron bocados.</p>
                {{/if}}
            {{/get}}
        </div>
    </section>

    {{> "bottom-cta"}}

</main>

{{#contentFor "body_class"}}archive-page{{/contentFor}}

