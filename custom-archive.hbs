{{!< default}}
{{!--
Template Name: Archive
--}}

<main class="archive-main">

    {{!-- Hero Section --}}
    <section class="archive-hero">
        <div class="gh-canvas">
            <h1 class="archive-title">Todos los <span class="accent-word">bocados</span></h1>
            <p class="archive-description">Explorá el archivo completo organizado por temas.</p>
        </div>
    </section>

    {{!-- Archive Sections by Tags --}}
    <section class="mm-content-sections archive-sections">
        <div class="mm-sections-wrapper">
            
            {{!-- Los Favoritos (Featured Posts) --}}
            {{#get "posts" filter="featured:true" limit="6" as |featured|}}
                {{#if featured}}
                    {{> "post-list-section" posts=featured title="Los favoritos"}}
                {{/if}}
            {{/get}}
            
            {{!-- Latest Posts --}}
            {{#get "posts" limit="6" as |latest|}}
                {{> "post-list-section" posts=latest title="Últimos bocados"}}
            {{/get}}
            
            {{!-- 
            Agrega más secciones aquí para diferentes tags
            Reemplaza "tag-name" con el slug real de tu tag
            --}}
            
            {{!-- Posts by Tag - La Bestia --}}
            {{#get "posts" filter="tag:la-bestia" limit="6" as |bestias|}}
                {{#if bestias}}
                    {{> "post-list-section" posts=bestias title="La Bestia"}}
                {{/if}}
            {{/get}}
            
            {{!-- Posts by Tag - La Llama --}}
            {{#get "posts" filter="tag:la-llama" limit="6" as |llamas|}}
                {{#if llamas}}
                    {{> "post-list-section" posts=llamas title="La Llama"}}
                {{/if}}
            {{/get}}

            {{!-- Posts by Tag - Source --}}
            {{#get "posts" filter="tag:source" limit="6" as |source|}}
                {{#if source}}
                    {{> "post-list-section" posts=source title="Source"}}
                {{/if}}
            {{/get}}

            {{!-- Posts by Tag - Liderazgo --}}
            {{#get "posts" filter="tag:liderazgo" limit="6" as |liderazgo|}}
                {{#if liderazgo}}
                    {{> "post-list-section" posts=liderazgo title="Liderazgo"}}
                {{/if}}
            {{/get}}
            
        </div>
    </section>

    {{> "bottom-cta"}}

</main>

{{#contentFor "body_class"}}archive-page{{/contentFor}}

