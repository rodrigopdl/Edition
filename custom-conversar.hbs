{{!< default}}
{{!--
Template Name: Conversar
--}}

<main class="homepage-main mm-v2 mm-conv">

    {{!-- 1. Hero ----------------------------------------------------------- --}}
    <section class="mm-v2-hero mm-conv-hero" aria-labelledby="conv-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <p class="mm-eyebrow">Conversar</p>

                <h1 class="mm-hero__title" id="conv-title">
                    Ordenemos <span class="mm-accent">qué está pasando.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Si estás atravesando una decisión, una tensión o una conversación importante, podés escribirme y contarme brevemente qué está pasando. No hace falta que tengas todo claro: el punto puede ser empezar por ordenar.</p>
                </div>

                <div class="mm-actions mm-actions--center">
                    <a href="#mm-conv-form" class="mm-btn mm-btn--primary">Escribirme</a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. Cómo funciona --------------------------------------------------- --}}
    <section class="mm-conv-how" aria-labelledby="conv-how-title">
        <div class="mm-canvas mm-canvas--narrow">
            <header class="mm-conv-how__header">
                <p class="mm-eyebrow">Cómo funciona</p>
                <h2 class="mm-v2-title" id="conv-how-title">
                    Un proceso <span class="mm-accent">simple.</span>
                </h2>
            </header>

            <ol class="mm-conv-how__list">
                <li class="mm-conv-how__step">
                    <span class="mm-conv-how__num" aria-hidden="true">01</span>
                    <p>Me contás brevemente qué está pasando.</p>
                </li>
                <li class="mm-conv-how__step">
                    <span class="mm-conv-how__num" aria-hidden="true">02</span>
                    <p>Leo tu mensaje y veo si siento que puedo ayudarte.</p>
                </li>
                <li class="mm-conv-how__step">
                    <span class="mm-conv-how__num" aria-hidden="true">03</span>
                    <p>Si tiene sentido, coordinamos una primera conversación exploratoria.</p>
                </li>
                <li class="mm-conv-how__step">
                    <span class="mm-conv-how__num" aria-hidden="true">04</span>
                    <p>Después definimos juntos qué forma de trabajo podría servir.</p>
                </li>
            </ol>
        </div>
    </section>

    {{!-- 3. Formulario ------------------------------------------------------ --}}
    <section class="mm-conv-form-section" id="mm-conv-form" aria-labelledby="conv-form-title">
        <div class="mm-canvas">
            <div class="mm-conv-form__panel">
                <header class="mm-conv-form__header">
                    <p class="mm-eyebrow">Escribime</p>
                    <h2 class="mm-v2-title" id="conv-form-title">
                        Contame qué <span class="mm-accent">estás masticando.</span>
                    </h2>
                    <p class="mm-conv-form__lede">
                        No hace falta que tengas todo ordenado. Justamente, el punto puede
                        ser empezar por ahí.
                    </p>
                </header>

                <form
                    id="mm-conv-formspree"
                    class="mm-conv-form"
                    action="https://formspree.io/f/maqpeljq"
                    method="POST"
                >
                    <div class="mm-conv-form__row mm-conv-form__row--two">
                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-name">
                                Nombre
                            </label>
                            <input
                                id="mm-conv-name"
                                name="nombre"
                                type="text"
                                autocomplete="name"
                                required
                                class="mm-conv-field__input"
                            >
                        </div>

                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-email">
                                Email
                            </label>
                            <input
                                id="mm-conv-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="mm-conv-field__input"
                            >
                        </div>
                    </div>

                    <div class="mm-conv-form__row">
                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-message">
                                Qué estás atravesando o qué te gustaría ordenar
                            </label>
                            <textarea
                                id="mm-conv-message"
                                name="mensaje"
                                rows="6"
                                required
                                class="mm-conv-field__textarea"
                            ></textarea>
                        </div>
                    </div>

                    {{!-- Honeypot (anti-spam, invisible para humanos) --}}
                    <div class="mm-conv-form__honeypot" aria-hidden="true">
                        <label for="mm-conv-website">No completar este campo</label>
                        <input id="mm-conv-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="mm-actions">
                        <button type="submit" class="mm-btn mm-btn--primary mm-btn--lg">
                            Enviar mensaje
                        </button>
                    </div>

                    <p id="mm-conv-form-status" class="mm-conv-form__status" role="status" aria-live="polite"></p>

                    <p class="mm-conv-form__fallback">
                        También podés escribirme a
                        <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                    </p>
                </form>
            </div>
        </div>
    </section>

    {{!-- 4. Puede tener sentido si... -------------------------------------- --}}
    <section class="mm-conv-when" aria-labelledby="conv-when-title">
        <div class="mm-canvas">
            <div class="mm-conv-when__inner">
                <header class="mm-conv-when__header">
                    <p class="mm-eyebrow">Cuándo</p>
                    <h2 class="mm-v2-title" id="conv-when-title">
                        Puede tener sentido <span class="mm-accent">si…</span>
                    </h2>
                </header>

                <ul class="mm-conv-when__list">
                    <li class="mm-conv-when__item">
                        Estás liderando algo importante y necesitás pensar mejor antes de avanzar.
                    </li>
                    <li class="mm-conv-when__item">
                        Hay una decisión, tensión o conversación que viene ocupando demasiado espacio mental.
                    </li>
                    <li class="mm-conv-when__item">
                        Tu equipo está creciendo, cambiando o atravesando un momento que pide más claridad.
                    </li>
                    <li class="mm-conv-when__item">
                        Querés ordenar lo que está pasando antes de actuar.
                    </li>
                    <li class="mm-conv-when__item">
                        No buscás una receta genérica, sino un espacio para mirar mejor.
                    </li>
                </ul>
            </div>
        </div>
    </section>

    {{!-- 5. De una primera conversación puede surgir... -------------------- --}}
    <section class="mm-conv-paths" aria-labelledby="conv-paths-title">
        <div class="mm-canvas">
            <header class="mm-section-header">
                <p class="mm-eyebrow">Caminos posibles</p>
                <h2 class="mm-v2-title" id="conv-paths-title">
                    De una primera conversación <span class="mm-accent">puede surgir…</span>
                </h2>
            </header>

            <div class="mm-conv-paths__grid">
                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Una conversación de claridad</h3>
                    <p class="mm-conv-path__text">
                        Un espacio individual para pensar mejor un desafío puntual,
                        ordenar ideas y encontrar próximos pasos.
                    </p>
                </article>

                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Una masticada</h3>
                    <p class="mm-conv-path__text">
                        Una experiencia de conversación para un equipo que necesita
                        frenar, pensar y abrir una conversación importante.
                    </p>
                </article>

                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Un acompañamiento</h3>
                    <p class="mm-conv-path__text">
                        Una relación más sostenida para líderes que no quieren pensar
                        solos sus decisiones, tensiones y próximos pasos.
                    </p>
                </article>
            </div>
        </div>
    </section>

    {{!-- 6. Cierre ---------------------------------------------------------- --}}
    <section class="mm-conv-closing" aria-labelledby="conv-closing-title">
        <div class="mm-canvas mm-canvas--narrow">
            <h2 class="mm-conv-closing__title" id="conv-closing-title">
                Hay cosas que se aclaran cuando <span class="mm-accent">alguien te ayuda a mirarlas mejor.</span>
            </h2>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2 page-conversar{{/contentFor}}

{{!-- AJAX submit: keeps the user on the page and shows inline feedback. --}}
<script>
(function () {
    var form = document.getElementById('mm-conv-formspree');
    if (!form) return;
    var status = document.getElementById('mm-conv-form-status');
    var submitBtn = form.querySelector('button[type="submit"]');

    function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg;
        status.dataset.state = state || '';
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.dataset.label = submitBtn.textContent;
            submitBtn.textContent = 'Enviando…';
        }
        setStatus('', 'loading');

        var data = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (res.ok) {
                form.reset();
                setStatus('Gracias. Te voy a leer y, si siento que puedo ayudarte, te escribo.', 'success');
            } else {
                return res.json().then(function (body) {
                    var msg = (body && body.errors && body.errors[0] && body.errors[0].message)
                        || 'Algo no funcionó. Probá de nuevo en un momento.';
                    setStatus(msg, 'error');
                }).catch(function () {
                    setStatus('Algo no funcionó. Probá de nuevo en un momento.', 'error');
                });
            }
        }).catch(function () {
            setStatus('No pudimos enviar el mensaje. Revisá tu conexión y probá de nuevo.', 'error');
        }).finally(function () {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.label || 'Enviar mensaje';
            }
        });
    });
})();
</script>
