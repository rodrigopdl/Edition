{{!< default}}
{{!--
Template Name: Conversar
--}}

<main class="homepage-main mm-v2 mm-conv">

    {{!-- 1. Hero ----------------------------------------------------------- --}}
    <section class="mm-v2-hero mm-conv-hero" aria-labelledby="conv-title">
        <div class="mm-canvas mm-canvas--wide">
            <div class="mm-hero__inner">
                <p class="mm-eyebrow">Conversar</p>

                <h1 class="mm-hero__title" id="conv-title">
                    Ordenemos <span class="mm-accent">qué está pasando.</span>
                </h1>

                <div class="mm-hero__lede">
                    <p>Si estás atravesando una decisión, una tensión o una conversación importante, podés escribirme y contarme brevemente qué está pasando.</p>
                    <p>No hace falta que tengas todo claro. El punto puede ser empezar por ordenar. Te voy a leer con atención y te respondo. Si sentimos que tiene sentido, vemos juntos qué forma de trabajo puede servir.</p>
                </div>

                <div class="mm-actions mm-actions--center">
                    <a href="#mm-conv-form" class="mm-btn mm-btn--primary">Escribirme</a>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2. De una primera conversación puede surgir... -------------------- --}}
    <section class="mm-conv-paths" aria-labelledby="conv-paths-title">
        <div class="mm-canvas">
            <header class="mm-section-header">
                <p class="mm-eyebrow">Caminos posibles</p>
                <h2 class="mm-v2-title" id="conv-paths-title">
                    Después de esa primera conversación <span class="mm-accent">puede surgir…</span>
                </h2>
            </header>

            <div class="mm-conv-paths__grid">
                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Una sesión de claridad</h3>
                    <p class="mm-conv-path__text">
                        Un espacio individual para pensar mejor un desafío puntual,
                        ordenar ideas y encontrar próximos pasos.
                    </p>
                </article>

                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Una masticada</h3>
                    <p class="mm-conv-path__text">
                        Una experiencia de conversación para un equipo que necesita
                        frenar, pensar y abrir una conversación importante.
                    </p>
                </article>

                <article class="mm-conv-path">
                    <h3 class="mm-conv-path__title">Un acompañamiento</h3>
                    <p class="mm-conv-path__text">
                        Una relación más sostenida para líderes que no quieren pensar
                        solos sus decisiones, tensiones y próximos pasos.
                    </p>
                </article>
            </div>
        </div>
    </section>

    {{!-- 3. Testimonio breve ------------------------------------------------ --}}
    <section class="mm-conv-quote" aria-labelledby="conv-quote-title">
        <div class="mm-canvas">
            <figure class="mm-conv-quote__figure">
                <blockquote class="mm-conv-quote__text" id="conv-quote-title">
                    <span class="mm-conv-quote__mark" aria-hidden="true">“</span>Rodri fue una de las voces que más nos ayudó a pensar sobre quiénes somos como organización y qué tipo de empresa queríamos construir. Su capacidad para articular ideas sobre liderazgo, autonomía, cultura y desarrollo humano generó conversaciones valiosas que dejaron huella en muchas personas dentro de WyeWorks.
                </blockquote>
                <figcaption class="mm-conv-quote__cite">
                    <div class="mm-conv-quote__avatar">
                        <img
                            src="{{asset "images/Jose.webp"}}"
                            alt="José Costa, Co-founder &amp; CEO de WyeWorks"
                            class="mm-conv-quote__avatar-img"
                            width="80"
                            height="80"
                            loading="lazy"
                        >
                    </div>
                    <div class="mm-conv-quote__person">
                        <span class="mm-conv-quote__name">José Costa</span>
                        <span class="mm-conv-quote__role">Co-founder &amp; CEO, WyeWorks</span>
                    </div>
                </figcaption>
            </figure>
        </div>
    </section>

    {{!-- 4. Formulario ------------------------------------------------------ --}}
    <section class="mm-conv-form-section" id="mm-conv-form" aria-labelledby="conv-form-title">
        <div class="mm-canvas">
            <div class="mm-conv-form__panel">
                <header class="mm-conv-form__header">
                    <p class="mm-eyebrow">Escribime</p>
                    <h2 class="mm-v2-title" id="conv-form-title">
                        Contame qué <span class="mm-accent">estás masticando.</span>
                    </h2>
                    <p class="mm-conv-form__lede">
                        No hace falta que tengas todo ordenado. Justamente, el punto puede
                        ser empezar por ahí.
                    </p>
                </header>

                <form
                    id="mm-conv-formspree"
                    class="mm-conv-form"
                    action="https://formspree.io/f/maqpeljq"
                    method="POST"
                >
                    <div class="mm-conv-form__row mm-conv-form__row--two">
                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-name">
                                Nombre
                            </label>
                            <input
                                id="mm-conv-name"
                                name="nombre"
                                type="text"
                                autocomplete="name"
                                required
                                class="mm-conv-field__input"
                            >
                        </div>

                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-email">
                                Email
                            </label>
                            <input
                                id="mm-conv-email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="mm-conv-field__input"
                            >
                        </div>
                    </div>

                    <div class="mm-conv-form__row">
                        <div class="mm-conv-field">
                            <label class="mm-conv-field__label" for="mm-conv-message">
                                ¿Qué hay en tu mente?
                            </label>
                            <textarea
                                id="mm-conv-message"
                                name="mensaje"
                                rows="6"
                                required
                                class="mm-conv-field__textarea"
                            ></textarea>
                        </div>
                    </div>

                    {{!-- Honeypot (anti-spam, invisible para humanos) --}}
                    <div class="mm-conv-form__honeypot" aria-hidden="true">
                        <label for="mm-conv-website">No completar este campo</label>
                        <input id="mm-conv-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="mm-actions">
                        <button type="submit" class="mm-btn mm-btn--primary mm-btn--lg">
                            Enviar mensaje
                        </button>
                    </div>

                    <p id="mm-conv-form-status" class="mm-conv-form__status" role="status" aria-live="polite"></p>

                    <p class="mm-conv-form__fallback">
                        También podés escribirme a
                        <a href="mailto:rodri@paramasticar.com">rodri@paramasticar.com</a>.
                    </p>
                </form>
            </div>
        </div>
    </section>

</main>

{{#contentFor "body_class"}}homepage-mm-v2 page-conversar{{/contentFor}}

{{!-- AJAX submit: keeps the user on the page and shows inline feedback. --}}
<script>
(function () {
    var form = document.getElementById('mm-conv-formspree');
    if (!form) return;
    var status = document.getElementById('mm-conv-form-status');
    var submitBtn = form.querySelector('button[type="submit"]');

    function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg;
        status.dataset.state = state || '';
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.dataset.label = submitBtn.textContent;
            submitBtn.textContent = 'Enviando…';
        }
        setStatus('', 'loading');

        var data = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
        }).then(function (res) {
            if (res.ok) {
                form.reset();
                setStatus('Gracias. Ya recibí tu mensaje. Te voy a leer con atención y te respondo pronto.', 'success');
            } else {
                return res.json().then(function (body) {
                    var msg = (body && body.errors && body.errors[0] && body.errors[0].message)
                        || 'Algo no funcionó. Probá de nuevo en un momento.';
                    setStatus(msg, 'error');
                }).catch(function () {
                    setStatus('Algo no funcionó. Probá de nuevo en un momento.', 'error');
                });
            }
        }).catch(function () {
            setStatus('No pudimos enviar el mensaje. Revisá tu conexión y probá de nuevo.', 'error');
        }).finally(function () {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.label || 'Enviar mensaje';
            }
        });
    });
})();
</script>
