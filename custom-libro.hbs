{{!-- Muestra: desplegar el capítulo en la misma página. Al abrir, scroll suave
     al comienzo del capítulo. El botón pasa a "Ocultar capítulo". --}}
<script>
(function () {
    'use strict';
    var toggle  = document.querySelector('.mm-lib-sample__toggle');
    var chapter = document.getElementById('mm-lib-chapter');
    if (!toggle || !chapter) return;

    var start = document.getElementById('mm-lib-chapter-start');

    toggle.addEventListener('click', function () {
        var isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        chapter.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
        chapter.classList.toggle('is-open', !isOpen);
        toggle.textContent = isOpen ? 'Leer el capítulo' : 'Ocultar capítulo';

        {{!-- Al abrir, llevar el comienzo del capítulo a la vista. --}}
        if (!isOpen && start) {
            setTimeout(function () {
                start.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 120);
        } else if (isOpen) {
            {{!-- Al cerrar, volver a la intro de la muestra. --}}
            var sample = document.getElementById('mm-lib-sample');
            if (sample) sample.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
})();
</script>

